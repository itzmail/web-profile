---
interface PageContext {
    type: "project" | "blog";
    title: string;
    description: string;
    extra?: string;
}

interface Props {
    pageContext?: PageContext;
}

const { pageContext } = Astro.props;
const pageContextJson = pageContext ? JSON.stringify(pageContext) : "";
---

<div class="chat-widget" id="chat-widget" data-page-context={pageContextJson}>
    <button class="chat-toggle" id="chat-toggle" aria-label="Buka chat AI">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8-1.19 0-2.326-.203-3.365-.575C7.87 20.163 6.5 21 4.5 21c-.5 0-.5-.5-.166-.833C5.11 19.4 5.5 18.5 5.5 17.5A8.038 8.038 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
    </button>

    <div class="chat-panel" id="chat-panel" hidden>
        <div class="chat-header">
            <span class="font-mono">// ismail.agent</span>
            <button class="chat-contact-pill" id="chat-contact-pill" hidden aria-label="Edit info kontak">
                <span id="chat-contact-pill-label"></span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
            </button>
            <button class="chat-close" id="chat-close" aria-label="Tutup chat">&times;</button>
        </div>
        <div class="chat-messages" id="chat-messages">
            <div class="chat-message chat-message--bot">
                Halo! Tanya apa saja tentang Ismail — pengalaman, project, atau skill-nya.
            </div>
        </div>
        <div class="chat-input-row">
            <input
                type="text"
                id="chat-input"
                class="chat-input"
                placeholder="Ketik pertanyaan..."
                maxlength="1000"
            />
            <button id="chat-send" class="chat-send" aria-label="Kirim">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                </svg>
            </button>
        </div>
    </div>
</div>

<script>
    import { marked } from "marked";
    import DOMPurify from "dompurify";

    const widget = document.getElementById("chat-widget");
    const toggle = document.getElementById("chat-toggle");
    const closeBtn = document.getElementById("chat-close");
    const panel = document.getElementById("chat-panel");
    const messagesEl = document.getElementById("chat-messages");
    const input = document.getElementById("chat-input") as HTMLInputElement | null;
    const sendBtn = document.getElementById("chat-send") as HTMLButtonElement | null;

    const rawPageContext = widget?.dataset.pageContext;
    const pageContext = rawPageContext ? JSON.parse(rawPageContext) : undefined;
    const pageContextKey = pageContext ? `${pageContext.type}:${pageContext.title}` : "";

    const HISTORY_KEY = "chat_history";
    const GREETED_KEY = "chat_greeted_context";
    const CONTACT_KEY = "chat_contact";

    interface HistoryMessage {
        role: "user" | "assistant";
        content: string;
    }

    interface ContactInfo {
        name: string;
        email: string;
    }

    function loadHistory(): HistoryMessage[] {
        try {
            const raw = sessionStorage.getItem(HISTORY_KEY);
            return raw ? (JSON.parse(raw) as HistoryMessage[]) : [];
        } catch {
            return [];
        }
    }

    const history: HistoryMessage[] = loadHistory();

    function persistHistory() {
        sessionStorage.setItem(HISTORY_KEY, JSON.stringify(history));
    }

    function loadContact(): ContactInfo | null {
        try {
            const raw = sessionStorage.getItem(CONTACT_KEY);
            return raw ? (JSON.parse(raw) as ContactInfo) : null;
        } catch {
            return null;
        }
    }

    function saveContact(contact: ContactInfo) {
        sessionStorage.setItem(CONTACT_KEY, JSON.stringify(contact));
        updateContactPill();
    }

    const contactPill = document.getElementById("chat-contact-pill") as HTMLButtonElement | null;
    const contactPillLabel = document.getElementById("chat-contact-pill-label");

    function updateContactPill() {
        if (!contactPill || !contactPillLabel) return;
        const contact = loadContact();
        if (!contact) {
            contactPill.hidden = true;
            return;
        }
        const label = contact.name.length > 18 ? `${contact.name.slice(0, 18)}…` : contact.name;
        contactPillLabel.textContent = label;
        contactPill.hidden = false;
    }

    function renderMarkdown(text: string): string {
        return DOMPurify.sanitize(marked.parse(text, { async: false }));
    }

    function appendMessage(role: "user" | "bot", content: string, asMarkdown = false): HTMLDivElement {
        const div = document.createElement("div");
        div.className = `chat-message chat-message--${role === "user" ? "user" : "bot"}`;
        if (asMarkdown) {
            div.innerHTML = renderMarkdown(content);
        } else {
            div.textContent = content;
        }
        messagesEl!.appendChild(div);
        messagesEl!.scrollTop = messagesEl!.scrollHeight;
        return div;
    }

    // Replay persisted history so it survives page navigation within the same tab.
    // Replaces the server-rendered default greeting once real history exists.
    if (history.length > 0) {
        messagesEl!.innerHTML = "";
        for (const msg of history) {
            appendMessage(msg.role === "user" ? "user" : "bot", msg.content, msg.role === "assistant");
        }
    }

    function showContextGreeting() {
        if (!pageContext || sessionStorage.getItem(GREETED_KEY) === pageContextKey) return;
        sessionStorage.setItem(GREETED_KEY, pageContextKey);

        const greeting =
            pageContext.type === "blog"
                ? `Lagi baca **${pageContext.title}**? Boleh tanya soal isi tulisan ini atau hal lain soal Ismail.`
                : `Lagi liat project **${pageContext.title}**? Tanya-tanya aja soal tech stack, cara kerja, atau hal lain soal Ismail.`;

        appendMessage("bot", greeting, true);
        history.push({ role: "assistant", content: greeting });
        persistHistory();
    }

    function setLoading(isLoading: boolean) {
        if (sendBtn) sendBtn.disabled = isLoading;
        if (input) input.disabled = isLoading;
    }

    function appendTypingIndicator(): HTMLDivElement {
        const div = document.createElement("div");
        div.className = "chat-message chat-message--bot chat-message--typing";
        div.innerHTML = "<span></span><span></span><span></span>";
        messagesEl!.appendChild(div);
        messagesEl!.scrollTop = messagesEl!.scrollHeight;
        return div;
    }

    function appendContactForm(question: string, prefill?: ContactInfo) {
        const wrapper = document.createElement("div");
        wrapper.className = "chat-message chat-message--bot chat-message--form";

        const nameInput = document.createElement("input");
        nameInput.type = "text";
        nameInput.placeholder = "Nama";
        nameInput.className = "chat-form-input";
        if (prefill?.name) nameInput.value = prefill.name;

        const emailInput = document.createElement("input");
        emailInput.type = "email";
        emailInput.placeholder = "Email";
        emailInput.className = "chat-form-input";
        if (prefill?.email) emailInput.value = prefill.email;

        const errorEl = document.createElement("div");
        errorEl.className = "chat-form-error";
        errorEl.hidden = true;

        const submitBtn = document.createElement("button");
        submitBtn.type = "button";
        submitBtn.className = "chat-form-submit";
        submitBtn.textContent = "Kirim";

        wrapper.appendChild(nameInput);
        wrapper.appendChild(emailInput);
        wrapper.appendChild(errorEl);
        wrapper.appendChild(submitBtn);
        messagesEl!.appendChild(wrapper);
        messagesEl!.scrollTop = messagesEl!.scrollHeight;

        submitBtn.addEventListener("click", async () => {
            const name = nameInput.value.trim();
            const email = emailInput.value.trim();

            if (!name || !email || !email.includes("@")) {
                errorEl.textContent = "Isi nama dan email yang valid ya.";
                errorEl.hidden = false;
                return;
            }

            errorEl.hidden = true;
            submitBtn.disabled = true;
            submitBtn.textContent = "Mengirim...";

            try {
                const res = await fetch("/api/chat/contact", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name, email, question, pageContext }),
                });

                if (!res.ok) {
                    const data = (await res.json().catch(() => ({}))) as { error?: string };
                    errorEl.textContent = data.error ?? "Gagal mengirim, coba lagi ya.";
                    errorEl.hidden = false;
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Kirim";
                    return;
                }

                saveContact({ name, email });
                wrapper.innerHTML = "";
                wrapper.textContent = "Sip, sudah aku teruskan ke Ismail. Nanti dia hubungi lewat email ya.";
                messagesEl!.scrollTop = messagesEl!.scrollHeight;
            } catch {
                errorEl.textContent = "Gagal mengirim, coba lagi ya.";
                errorEl.hidden = false;
                submitBtn.disabled = false;
                submitBtn.textContent = "Kirim";
            }
        });
    }

    async function sendMessage() {
        if (!input) return;
        const text = input.value.trim();
        if (!text) return;

        appendMessage("user", text);
        history.push({ role: "user", content: text });
        persistHistory();
        input.value = "";
        setLoading(true);

        const typingEl = appendTypingIndicator();

        try {
            const res = await fetch("/api/chat", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ messages: history, pageContext }),
            });

            if (!res.ok) {
                const data = (await res.json()) as { error?: string };
                typingEl.classList.remove("chat-message--typing");
                typingEl.textContent = data.error ?? "Maaf, chatbot lagi bermasalah, coba lagi nanti.";
                return;
            }

            if (!res.body) {
                typingEl.classList.remove("chat-message--typing");
                typingEl.textContent = "Maaf, chatbot lagi bermasalah, coba lagi nanti.";
                return;
            }

            const isForward = res.headers.get("X-Chat-Action") === "collect-contact";

            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            let fullReply = "";
            let firstChunk = true;

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                fullReply += decoder.decode(value, { stream: true });
                if (firstChunk) {
                    typingEl.classList.remove("chat-message--typing");
                    typingEl.innerHTML = "";
                    firstChunk = false;
                }
                typingEl.textContent = fullReply;
                messagesEl!.scrollTop = messagesEl!.scrollHeight;
            }

            typingEl.classList.remove("chat-message--typing");

            if (isForward) {
                // Fixed forward message is shown but deliberately not persisted to history —
                // otherwise the model sees it as a prior example and keeps forwarding.
                typingEl.textContent = fullReply;
                messagesEl!.scrollTop = messagesEl!.scrollHeight;

                const savedContact = loadContact();
                if (savedContact) {
                    try {
                        await fetch("/api/chat/contact", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ ...savedContact, question: text, pageContext }),
                        });
                        appendMessage("bot", "Sudah aku teruskan ke Ismail ya.");
                    } catch {
                        appendMessage("bot", "Gagal mengirim, coba lagi ya.");
                    }
                } else {
                    appendContactForm(text);
                }
                return;
            }

            typingEl.innerHTML = renderMarkdown(fullReply);
            messagesEl!.scrollTop = messagesEl!.scrollHeight;
            history.push({ role: "assistant", content: fullReply });
            persistHistory();
        } catch {
            typingEl.classList.remove("chat-message--typing");
            typingEl.textContent = "Maaf, chatbot lagi bermasalah, coba lagi nanti.";
        } finally {
            setLoading(false);
        }
    }

    toggle?.addEventListener("click", () => {
        if (panel) panel.hidden = !panel.hidden;
        if (panel && !panel.hidden) showContextGreeting();
    });
    closeBtn?.addEventListener("click", () => {
        if (panel) panel.hidden = true;
    });
    sendBtn?.addEventListener("click", sendMessage);
    input?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") sendMessage();
    });
    contactPill?.addEventListener("click", () => {
        if (panel) panel.hidden = false;
        const savedContact = loadContact();
        const lastUserMessage = [...history].reverse().find((m) => m.role === "user");
        appendContactForm(lastUserMessage?.content ?? "(update info kontak)", savedContact ?? undefined);
    });

    updateContactPill();
</script>

<style>
    .chat-widget {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 100;
    }

    .chat-toggle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--green);
        color: #000;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        transition: transform 0.2s var(--ease);
    }

    .chat-toggle:hover {
        transform: scale(1.05);
    }

    .chat-panel[hidden] {
        display: none;
    }

    .chat-panel {
        position: absolute;
        bottom: 64px;
        right: 0;
        width: 420px;
        max-height: 640px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    }

    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .chat-close {
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 1.2rem;
        cursor: pointer;
        line-height: 1;
    }

    .chat-contact-pill {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        color: var(--text-muted);
        font-size: 0.7rem;
        cursor: pointer;
        transition: color 0.2s var(--ease);
    }

    .chat-contact-pill:hover {
        color: var(--text);
    }

    .chat-contact-pill[hidden] {
        display: none;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        min-height: 300px;
        max-height: 500px;
    }

    :global(.chat-message) {
        font-size: 0.78rem;
        line-height: 1.5;
        padding: 0.45rem 0.7rem;
        border-radius: 8px;
        max-width: 85%;
    }

    :global(.chat-message--bot) {
        background: var(--surface-hover);
        border: 1px solid var(--border);
        color: var(--text);
        align-self: flex-start;
    }

    :global(.chat-message--bot p) {
        margin: 0 0 0.5em;
    }

    :global(.chat-message--bot p:last-child) {
        margin-bottom: 0;
    }

    :global(.chat-message--bot strong) {
        color: var(--text);
        font-weight: 700;
    }

    :global(.chat-message--bot ul),
    :global(.chat-message--bot ol) {
        margin: 0.3em 0;
        padding-left: 1.2em;
    }

    :global(.chat-message--bot code) {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 4px;
        padding: 0.1em 0.35em;
        font-size: 0.9em;
    }

    :global(.chat-message--user) {
        background: var(--green);
        color: #000;
        align-self: flex-end;
    }

    :global(.chat-message--typing) {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.6rem 0.8rem;
    }

    :global(.chat-message--typing span) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-muted);
        animation: chat-typing-bounce 1.2s infinite ease-in-out;
    }

    :global(.chat-message--typing span:nth-child(2)) {
        animation-delay: 0.2s;
    }

    :global(.chat-message--typing span:nth-child(3)) {
        animation-delay: 0.4s;
    }

    :global(.chat-message--form) {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        width: 100%;
        max-width: 100%;
    }

    :global(.chat-form-input) {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.4rem 0.6rem;
        color: var(--text);
        font-size: 0.78rem;
    }

    :global(.chat-form-error) {
        color: #e5484d;
        font-size: 0.72rem;
    }

    :global(.chat-form-submit) {
        background: var(--green);
        color: #000;
        border: none;
        border-radius: 6px;
        padding: 0.4rem 0.6rem;
        font-size: 0.78rem;
        cursor: pointer;
    }

    :global(.chat-form-submit:disabled) {
        opacity: 0.5;
        cursor: not-allowed;
    }

    @keyframes chat-typing-bounce {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }
        30% {
            transform: translateY(-4px);
            opacity: 1;
        }
    }

    .chat-input-row {
        display: flex;
        gap: 0.5rem;
        padding: 0.75rem;
        border-top: 1px solid var(--border);
    }

    .chat-input {
        flex: 1;
        min-width: 0;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        color: var(--text);
        font-size: 0.78rem;
    }

    .chat-send {
        width: 36px;
        height: 36px;
        border-radius: 6px;
        background: var(--green);
        color: #000;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .chat-send:disabled,
    .chat-input:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    @media (max-width: 480px) {
        .chat-panel {
            width: calc(100vw - 2rem);
            right: -0.5rem;
        }

        .chat-input {
            font-size: 16px;
        }
    }
</style>
