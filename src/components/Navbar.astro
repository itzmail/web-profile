---
import SunIcon from "../assets/icons/SunIcon.astro";
import MoonIcon from "../assets/icons/MoonIcon.astro";
---

<nav class="navbar" id="navbar">
    <div class="container nav-inner">
        <a href="https://itsmail.dev/" class="nav-logo">
            <span class="logo-bracket">[</span>itsmail<span class="logo-dot"
                >.</span
            >dev<span class="logo-bracket">]</span>
        </a>

        <ul class="nav-links" id="navLinks">
            <li><a href="https://itsmail.dev/projects" class="nav-link">Projects</a></li>
            <li><a href="https://itsmail.dev/certificates" class="nav-link">Certificates</a></li>
            <li><a href="/blog" class="nav-link">Blog</a></li>
        </ul>

        <div class="nav-actions">
            <button
                class="nav-action-btn nav-term-toggle"
                id="navTermToggle"
                aria-label="Toggle Terminal (Ctrl + `)"
                title="Toggle Developer Terminal (Ctrl + `)"
            >
                <span class="term-toggle-icon font-mono">&gt;_</span>
            </button>
            <button class="nav-action-btn theme-toggle" id="themeToggle" aria-label="Toggle theme" title="Toggle theme">
                <SunIcon class="theme-icon theme-icon-sun" width="18" height="18" />
                <MoonIcon class="theme-icon theme-icon-moon" width="18" height="18" />
            </button>
            <button
                class="nav-toggle"
                id="navToggle"
                aria-label="Toggle navigation"
            >
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</nav>

<style>
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        height: var(--nav-h);
        transition: all 0.3s var(--ease);
        border-bottom: 1px solid transparent;
    }

    .navbar.scrolled {
        background: var(--nav-scrolled-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom-color: var(--border);
    }

    .nav-inner {
        display: flex;
        align-items: center;
        height: 100%;
        gap: 1.5rem;
    }

    .nav-logo {
        font-family: var(--font-mono);
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        text-decoration: none;
        letter-spacing: -0.02em;
        flex-shrink: 0;
    }

    .logo-bracket {
        color: var(--green);
    }
    .logo-dot {
        color: var(--cyan);
    }

    .nav-links {
        list-style: none;
        display: flex;
        gap: 0.25rem;
        margin-left: auto;
    }

    .nav-link {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.5rem 0.875rem;
        border-radius: 6px;
        transition: all var(--duration) var(--ease);
        position: relative;
    }

    .nav-link::before {
        content: "";
        position: absolute;
        bottom: 2px;
        left: 0.875rem;
        right: 0.875rem;
        height: 1px;
        background: var(--green);
        transform: scaleX(0);
        transition: transform var(--duration) var(--ease);
    }

    .nav-link:hover {
        color: var(--green);
    }

    .nav-link:hover::before {
        transform: scaleX(1);
    }

    /* ── Nav Actions Container ───────────────────────────────── */
    .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .nav-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: transparent;
        border: 1px solid var(--border-glow);
        border-radius: 8px;
        cursor: pointer;
        color: var(--text-muted);
        flex-shrink: 0;
        transition: all var(--duration) var(--ease);
    }

    .nav-action-btn:hover {
        color: var(--green);
        border-color: var(--green);
        background: var(--green-glow);
        box-shadow: 0 0 12px var(--green-glow);
    }

    /* Terminal toggle button */
    .nav-term-toggle {
        color: var(--green);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
    }

    /* Theme toggle */
    :global(.theme-icon) {
        display: block;
        transition: transform var(--duration) var(--ease);
    }

    :global(.theme-icon-moon) {
        display: none;
    }

    :global([data-theme="light"] .theme-icon-sun) {
        display: none;
    }

    :global([data-theme="light"] .theme-icon-moon) {
        display: block;
    }

    /* Mobile toggle */
    .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 4px;
        width: 36px;
        height: 36px;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 8px;
        cursor: pointer;
        padding: 0;
        flex-shrink: 0;
        transition: all var(--duration) var(--ease);
    }

    .nav-toggle:hover {
        border-color: var(--border-glow);
        background: rgba(255, 255, 255, 0.04);
    }

    .nav-toggle span {
        display: block;
        width: 18px;
        height: 2px;
        background: var(--text);
        border-radius: 2px;
        transition: all var(--duration) var(--ease);
    }

    .nav-toggle.active span:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }
    .nav-toggle.active span:nth-child(2) {
        opacity: 0;
    }
    .nav-toggle.active span:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    @media (max-width: 768px) {
        .nav-inner {
            justify-content: space-between;
            gap: 1rem;
        }

        .nav-actions {
            margin-left: auto;
            gap: 0.45rem;
        }

        .nav-toggle {
            display: flex;
        }

        .nav-links {
            position: fixed;
            top: var(--nav-h);
            left: 0;
            right: 0;
            z-index: 999;
            background: var(--nav-mobile-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            flex-direction: column;
            padding: 1.5rem;
            gap: 0.5rem;
            border-bottom: 1px solid var(--border);
            transform: translateY(calc(-100% - var(--nav-h)));
            transition: transform 0.3s var(--ease);
            margin-left: 0;
            pointer-events: none;
        }

        .nav-links.open {
            transform: translateY(0);
            pointer-events: auto;
        }

        .nav-link {
            padding: 0.875rem 1rem;
            font-size: 1rem;
        }
    }

    @media (max-width: 480px) {
        .nav-logo {
            font-size: 0.9rem;
        }

        .nav-actions {
            gap: 0.35rem;
        }

        .nav-action-btn,
        .nav-toggle {
            width: 32px;
            height: 32px;
        }

        .nav-term-toggle {
            font-size: 0.75rem;
        }

        .theme-icon {
            width: 16px;
            height: 16px;
        }

        .nav-toggle span {
            width: 16px;
        }
    }
</style>

<script>
    const navbar = document.getElementById("navbar");
    const toggle = document.getElementById("navToggle");
    const links = document.getElementById("navLinks");
    const themeToggle = document.getElementById("themeToggle");
    const navTermToggle = document.getElementById("navTermToggle");

    // Terminal toggle
    navTermToggle?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("toggle-terminal"));
    });

    // Theme toggle
    themeToggle?.addEventListener("click", () => {
        const html = document.documentElement;
        const isLight = html.getAttribute("data-theme") === "light";
        const next = isLight ? "dark" : "light";
        html.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
    });

    // Scroll effect
    window.addEventListener("scroll", () => {
        navbar?.classList.toggle("scrolled", window.scrollY > 20);
    });

    // Mobile toggle
    toggle?.addEventListener("click", () => {
        toggle.classList.toggle("active");
        links?.classList.toggle("open");
    });

    // Close on link click
    links?.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", () => {
            toggle?.classList.remove("active");
            links.classList.remove("open");
        });
    });

    // Active link on scroll
    const sections = document.querySelectorAll("section[id]");
    const navLinksEls = document.querySelectorAll(".nav-link");
    const io = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    navLinksEls.forEach((link) => {
                        link.classList.toggle(
                            "active",
                            link.getAttribute("href") === `#${entry.target.id}`
                        );
                    });
                }
            });
        },
        { rootMargin: "-40% 0px -50% 0px" }
    );
    sections.forEach((s) => io.observe(s));
</script>
