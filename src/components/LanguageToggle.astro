---
// Compact Language Selector Dropdown (Icon + Badge)
---

<div class="lang-selector-container" id="langSelector">
    <button
        type="button"
        class="nav-action-btn lang-trigger"
        id="langTrigger"
        aria-label="Change language"
        aria-haspopup="true"
        aria-expanded="false"
        title="Change Language / Ganti Bahasa"
    >
        <svg
            class="lang-globe-icon"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="lang-current-code font-mono" id="langCurrentCode">EN</span>
    </button>

    <!-- Dropdown Menu -->
    <div class="lang-dropdown font-mono" id="langDropdown">
        <button type="button" class="lang-item active" data-lang="en">
            <span class="lang-name">English</span>
            <span class="lang-code-pill">EN</span>
        </button>
        <button type="button" class="lang-item" data-lang="id">
            <span class="lang-name">Bahasa Indonesia</span>
            <span class="lang-code-pill">ID</span>
        </button>
    </div>
</div>

<style>
    .lang-selector-container {
        position: relative;
        display: inline-block;
    }

    .lang-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        height: 36px;
        padding: 0 0.55rem;
        background: transparent;
        border: 1px solid var(--border-glow, rgba(255, 255, 255, 0.1));
        border-radius: 8px;
        color: var(--text-muted);
        cursor: pointer;
        transition: all var(--duration, 0.2s) var(--ease, ease);
        user-select: none;
    }

    .lang-trigger:hover,
    .lang-trigger[aria-expanded="true"] {
        color: var(--green, #00ff88);
        border-color: var(--green, #00ff88);
        background: var(--green-glow, rgba(0, 255, 136, 0.08));
        box-shadow: 0 0 12px var(--green-glow, rgba(0, 255, 136, 0.15));
    }

    .lang-globe-icon {
        flex-shrink: 0;
        opacity: 0.85;
    }

    .lang-current-code {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    /* Dropdown Panel */
    .lang-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 175px;
        background: var(--bg-card, #121820);
        border: 1px solid var(--border-glow, rgba(255, 255, 255, 0.15));
        border-radius: 8px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 0.35rem;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.08);
        z-index: 1050;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    }

    :global([data-theme="light"]) .lang-dropdown {
        background: #ffffff;
        border-color: rgba(0, 0, 0, 0.12);
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
    }

    .lang-dropdown.open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    /* Dropdown Items */
    .lang-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 0.5rem 0.65rem;
        background: transparent;
        border: none;
        border-radius: 6px;
        color: var(--text-muted, #8b949e);
        font-size: 0.8rem;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .lang-item:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text, #ffffff);
    }

    :global([data-theme="light"]) .lang-item:hover {
        background: rgba(0, 0, 0, 0.06);
        color: #111111;
    }

    .lang-item.active {
        color: var(--green, #00ff88);
        background: rgba(0, 255, 136, 0.1);
        font-weight: 600;
    }

    .lang-code-pill {
        font-size: 0.68rem;
        padding: 0.12rem 0.38rem;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-muted, #8b949e);
    }

    .lang-item.active .lang-code-pill {
        background: rgba(0, 255, 136, 0.2);
        color: var(--green, #00ff88);
        font-weight: 700;
    }
</style>

<script>
    import { translations, type Language } from "../i18n/translations";

    function applyLanguage(lang: Language) {
        document.documentElement.setAttribute("data-lang", lang);
        try {
            localStorage.setItem("itsmail_lang", lang);
        } catch {
            // Safe fallback
        }

        // Update trigger button label
        const currentCodeEl = document.getElementById("langCurrentCode");
        if (currentCodeEl) {
            currentCodeEl.textContent = lang.toUpperCase();
        }

        // Update active class in dropdown
        document.querySelectorAll(".lang-item").forEach((item) => {
            const itemLang = item.getAttribute("data-lang");
            if (itemLang === lang) {
                item.classList.add("active");
            } else {
                item.classList.remove("active");
            }
        });

        const dict = translations[lang] || translations.en;

        // Auto-update elements with data-i18n attribute
        document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
            const keyPath = el.getAttribute("data-i18n");
            if (!keyPath) return;

            const keys = keyPath.split(".");
            let val: any = dict;
            for (const k of keys) {
                if (val && typeof val === "object" && k in val) {
                    val = val[k];
                } else {
                    val = null;
                    break;
                }
            }

            if (typeof val === "string") {
                el.textContent = val;
            }
        });

        // Dispatch Custom Event for interactive components
        window.dispatchEvent(
            new CustomEvent("langchange", {
                detail: { lang, dict }
            })
        );
    }

    function initLangSelector() {
        const trigger = document.getElementById("langTrigger");
        const dropdown = document.getElementById("langDropdown");

        const savedLang = (typeof localStorage !== "undefined" && (localStorage.getItem("itsmail_lang") as Language)) || "en";
        applyLanguage(savedLang);

        if (!trigger || !dropdown) return;
        if (trigger.dataset.langInit === "true") return;
        trigger.dataset.langInit = "true";

        // Toggle dropdown open/close
        trigger.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen = dropdown.classList.contains("open");
            if (isOpen) {
                dropdown.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");
            } else {
                dropdown.classList.add("open");
                trigger.setAttribute("aria-expanded", "true");
            }
        });

        // Select language option
        dropdown.querySelectorAll(".lang-item").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const targetLang = (btn.getAttribute("data-lang") as Language) || "en";
                applyLanguage(targetLang);
                dropdown.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");
            });
        });

        // Close on outside click
        document.addEventListener("click", (e) => {
            if (!trigger.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
                dropdown.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");
            }
        });

        // Close on Escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && dropdown.classList.contains("open")) {
                dropdown.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");
                trigger.focus();
            }
        });
    }

    // Initialize on load and on Astro view transitions
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLangSelector);
    } else {
        initLangSelector();
    }
    document.addEventListener("astro:page-load", initLangSelector);
</script>
