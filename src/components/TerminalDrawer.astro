---
import { apiFetch } from "../utils/api";
import type { ApiProject, ApiSocial, Experience } from "../types/index";

const [apiExperiences, apiProjects, apiSocials] = await Promise.all([
    apiFetch<Experience[]>("/experiences"),
    apiFetch<ApiProject[]>("/projects"),
    apiFetch<ApiSocial[]>("/socials"),
]);

const termExperiences = (apiExperiences ?? []).map((e) => ({
    role: `${e.title} · ${e.web_profile.data.company}`,
    period: e.web_profile.data.date,
    desc: e.description,
}));

const termProjects = apiProjects
    ? apiProjects.map((p) => ({
          name: p.title,
          stack: p.web_profile.data.stack.join(" · "),
          desc: p.description,
      }))
    : [];

const termSocials = apiSocials
    ? apiSocials.map((s) => ({
          name: s.title,
          iconUrl: s.web_profile.data.icon_url,
          href: s.web_profile.data.href,
          user: s.web_profile.data.user,
      }))
    : [];

interface MasterItem {
    key: string;
    value: string;
    metadata: { category: string; icon: string };
    order: number;
}
interface MasterResponse {
    items: MasterItem[];
}

const apiSkills = await apiFetch<MasterResponse>("/master/skills");

const termSkills: Record<string, string[]> = {};
if (apiSkills) {
    for (const item of apiSkills.items) {
        const cat = item.metadata.category;
        if (!termSkills[cat]) termSkills[cat] = [];
        termSkills[cat].push(item.value);
    }
} else {
    Object.assign(termSkills, {
        Backend: ["Express.js", "Spring Boot", "Golang", "Java", "Node.js"],
        Frontend: ["React.js", "Next.js", "JavaScript", "TypeScript"],
        Mobile: ["Flutter", "React Native", "Dart"],
        Database: ["PostgreSQL"],
        Tools: ["Git"],
    });
}

const termData = JSON.stringify({ termProjects, termExperiences, termSocials, termSkills });
---

<!-- Fixed Docked Bottom Drawer (GCP Cloud Shell style) -->
<div
    class="terminal-drawer"
    id="terminalDrawer"
    role="dialog"
    aria-label="Developer Shell"
    aria-hidden="true"
>
    <!-- Titlebar / Header -->
    <div class="terminal-titlebar" id="termTitlebar">
        <div class="terminal-header-left">
            <div class="terminal-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
            </div>
            <div class="terminal-tag">
                <span class="term-prompt-icon font-mono">&gt;_</span>
                <span class="terminal-title font-mono">ismail@portfolio: ~ (bash)</span>
            </div>
        </div>

        <div class="terminal-header-right">
            <span class="shortcut-badge font-mono" title="Shortcut to toggle terminal">Ctrl + `</span>

            <!-- Minimize / Collapse -->
            <button
                type="button"
                class="term-action-btn"
                id="termMinimizeBtn"
                aria-label="Minimize terminal"
                title="Minimize / Collapse"
            >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>

            <!-- Maximize / Restore -->
            <button
                type="button"
                class="term-action-btn"
                id="termMaximizeBtn"
                aria-label="Maximize terminal"
                title="Maximize (85vh) / Restore"
            >
                <svg class="icon-maximize" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                </svg>
                <svg class="icon-restore" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="4 14 10 14 10 20"></polyline>
                    <polyline points="20 10 14 10 14 4"></polyline>
                    <line x1="14" y1="10" x2="21" y2="3"></line>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
            </button>

            <!-- Close -->
            <button
                type="button"
                class="term-action-btn term-action-close"
                id="termCloseBtn"
                aria-label="Close terminal"
                title="Close (Esc)"
            >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    <!-- Terminal Body -->
    <div class="terminal-body" id="termBody">
        <div class="terminal-output" id="termOutput"></div>

        <!-- Input Row -->
        <div class="terminal-input-row">
            <span class="prompt">
                ismail<span class="at">@</span>portfolio<span class="colon">:</span><span class="tilde">~</span><span class="dollar">$</span>
            </span>
            <input
                type="text"
                id="termInput"
                class="terminal-input"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="type 'help' to discover me..."
                aria-label="Terminal input"
            />
        </div>
    </div>
</div>

<style>
    /* ── Terminal Bottom Drawer (GCP Cloud Shell style) ──────── */
    .terminal-drawer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1100;
        height: 380px;
        max-height: 50vh;
        background: rgba(10, 10, 15, 0.96);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-top: 1px solid var(--border-glow);
        box-shadow: 0 -12px 48px rgba(0, 0, 0, 0.8),
            0 0 30px rgba(0, 255, 136, 0.08);
        display: flex;
        flex-direction: column;
        transform: translateY(100%);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            height 0.25s ease,
            max-height 0.25s ease,
            visibility 0.3s;
        visibility: hidden;
        pointer-events: none;
        font-family: var(--font-mono);
    }

    .terminal-drawer.is-open {
        transform: translateY(0);
        visibility: visible;
        pointer-events: auto;
    }

    .terminal-drawer.is-minimized {
        height: 42px !important;
        max-height: 42px !important;
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.6);
    }

    .terminal-drawer.is-minimized .terminal-body {
        display: none !important;
    }

    .terminal-drawer.is-maximized {
        height: 85vh !important;
        max-height: 85vh !important;
    }

    /* ── Titlebar ────────────────────────────────────────────── */
    .terminal-titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 42px;
        min-height: 42px;
        padding: 0 1rem;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        cursor: pointer;
        user-select: none;
        flex-shrink: 0;
    }

    .terminal-header-left {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .terminal-dots {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
    }
    .dot-red { background: #ff5f57; }
    .dot-yellow { background: #febc2e; }
    .dot-green { background: #28c840; }

    .terminal-tag {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .term-prompt-icon {
        color: var(--green);
        font-weight: 700;
        font-size: 0.85rem;
    }

    .terminal-title {
        font-size: 0.75rem;
        color: var(--text-muted);
        letter-spacing: 0.03em;
    }

    .terminal-header-right {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .shortcut-badge {
        font-size: 0.65rem;
        color: var(--text-dim);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        margin-right: 0.5rem;
    }

    @media (max-width: 640px) {
        .shortcut-badge {
            display: none;
        }
    }

    .term-action-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all var(--duration) var(--ease);
    }

    .term-action-btn:hover {
        color: var(--text);
        background: rgba(255, 255, 255, 0.08);
    }

    .term-action-close:hover {
        color: #ffffff;
        background: var(--red);
    }

    .icon-restore {
        display: none;
    }

    .terminal-drawer.is-maximized .icon-maximize {
        display: none;
    }

    .terminal-drawer.is-maximized .icon-restore {
        display: block;
    }

    /* ── Terminal Body ───────────────────────────────────────── */
    .terminal-body {
        flex: 1;
        min-height: 0;
        padding: 1.25rem 1.5rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        cursor: text;
    }

    .terminal-output {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        font-size: 0.8125rem;
        line-height: 1.6;
        color: var(--text);
    }

    .terminal-input-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .prompt {
        font-size: 0.8125rem;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .prompt .at { color: var(--text-muted); }
    .prompt .colon { color: var(--text-muted); }
    .prompt .tilde { color: var(--cyan); }
    .prompt .dollar {
        color: var(--green);
        margin-left: 2px;
    }

    .terminal-input {
        flex: 1;
        min-width: 0;
        background: transparent;
        border: none;
        outline: none;
        color: var(--green);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        caret-color: var(--green);
    }

    .terminal-input::placeholder {
        color: var(--text-dim);
    }

    /* Output line formatting */
    :global(.t-line) {
        display: flex;
        align-items: flex-start;
        gap: 0.375rem;
    }
    :global(.t-cmd) {
        color: var(--green);
    }
    :global(.t-prompt-echo) {
        color: var(--text-muted);
        font-size: 0.75rem;
    }
    :global(.t-output) {
        color: var(--text);
        padding-left: 0.5rem;
    }
    :global(.t-success) {
        color: var(--green);
    }
    :global(.t-error) {
        color: var(--red);
    }
    :global(.t-info) {
        color: var(--cyan);
    }
    :global(.t-purple) {
        color: var(--purple);
    }
    :global(.t-dim) {
        color: var(--text-muted);
    }
    :global(.t-bold) {
        font-weight: 700;
    }
    :global(.t-block) {
        display: block;
        padding-left: 0.5rem;
    }
    :global(.t-separator) {
        border-top: 1px solid var(--border);
        margin: 0.5rem 0;
    }

    /* Scrollbar */
    .terminal-body::-webkit-scrollbar {
        width: 5px;
    }
    .terminal-body::-webkit-scrollbar-track {
        background: transparent;
    }
    .terminal-body::-webkit-scrollbar-thumb {
        background: var(--surface-border);
        border-radius: 3px;
    }

    @media (max-width: 576px) {
        .terminal-body {
            padding: 1rem;
        }
        .terminal-input {
            font-size: 16px;
        }
    }
</style>

<script type="application/json" id="termDrawerData" set:html={termData}></script>

<script>
    interface ProjectItem {
        name: string;
        stack: string;
        desc: string;
    }
    interface ExperienceItem {
        role: string;
        period: string;
        desc: string;
    }
    interface SocialItem {
        name: string;
        iconUrl: string;
        href: string;
        user: string;
    }

    const drawer = document.getElementById("terminalDrawer");
    const output = document.getElementById("termOutput");
    const input = document.getElementById("termInput") as HTMLInputElement | null;
    const body = document.getElementById("termBody");
    const titlebar = document.getElementById("termTitlebar");
    const minimizeBtn = document.getElementById("termMinimizeBtn");
    const maximizeBtn = document.getElementById("termMaximizeBtn");
    const closeBtn = document.getElementById("termCloseBtn");

    let history: string[] = [];
    let histIdx = -1;
    let isBooted = false;

    // ── Data ──────────────────────────────────────────────────────
    const DATA = {
        name: "Ismail Nur Alam",
        role: "Fullstack Engineer for Hire",
        location: "Kota Magelang, Indonesia 🇮🇩",
        email: "ismailnuralam@gmail.com",
        bio: "I help businesses ship fast, reliable products — from mobile apps to backend APIs. 3 years, 20+ products delivered, zero ghosted deadlines.",
    };

    const dataEl = document.getElementById("termDrawerData");
    const parsedData = dataEl && dataEl.textContent ? JSON.parse(dataEl.textContent) : {};
    const PROJECTS: ProjectItem[] = parsedData.termProjects || [];
    const EXPERIENCE: ExperienceItem[] = parsedData.termExperiences || [];
    const SOCIALS: SocialItem[] = parsedData.termSocials || [];
    const SKILLS: Record<string, string[]> = parsedData.termSkills || {};

    // ── Drawer State Controls ─────────────────────────────────────
    function openTerminal() {
        if (!drawer) return;
        drawer.classList.add("is-open");
        drawer.setAttribute("aria-hidden", "false");
        drawer.classList.remove("is-minimized");
        if (!isBooted) {
            boot();
            isBooted = true;
        }
        setTimeout(() => input?.focus(), 150);
    }

    function closeTerminal() {
        if (!drawer) return;
        drawer.classList.remove("is-open", "is-maximized", "is-minimized");
        drawer.setAttribute("aria-hidden", "true");
    }

    function toggleTerminal() {
        if (!drawer) return;
        if (drawer.classList.contains("is-open")) {
            closeTerminal();
        } else {
            openTerminal();
        }
    }

    function toggleMinimize() {
        if (!drawer) return;
        drawer.classList.toggle("is-minimized");
        if (!drawer.classList.contains("is-minimized")) {
            setTimeout(() => input?.focus(), 100);
        }
    }

    function toggleMaximize() {
        if (!drawer) return;
        drawer.classList.remove("is-minimized");
        drawer.classList.toggle("is-maximized");
        setTimeout(() => input?.focus(), 100);
    }

    // ── Helpers ───────────────────────────────────────────────────
    function appendLine(html: string) {
        if (!output || !body) return;
        const div = document.createElement("div");
        div.innerHTML = html;
        output.appendChild(div);
        body.scrollTo({ top: body.scrollHeight, behavior: "smooth" });
    }

    function spacer() {
        appendLine('<div style="height:6px"></div>');
    }

    function escHTML(s: string) {
        return s
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
    }

    function printCmd(cmd: string) {
        appendLine(
            `<div class="t-line">
      <span class="prompt" style="opacity:.5">ismail<span class="at">@</span>portfolio:</span>
      <span class="t-cmd">$ ${escHTML(cmd)}</span>
    </div>`
        );
    }

    // ── Commands ──────────────────────────────────────────────────
    const commands: Record<string, () => void> = {
        help() {
            spacer();
            appendLine(`<span class="t-info t-bold">Available commands:</span>`);
            const cmds = [
                ["whoami", "Who am I & why hire me"],
                ["skills", "Tech stack & proficiency"],
                ["projects", "Selected projects with outcomes"],
                ["experience", "Work history & what I delivered"],
                ["availability", "Current status & response time"],
                ["contact", "Get in touch"],
                ["clear", "Clear terminal"],
                ["motto", "My engineering philosophy"],
                ["secret", "?"],
            ];
            cmds.forEach(([c, d]) => {
                appendLine(
                    `<div class="t-line t-block"><span class="t-success" style="min-width:110px;display:inline-block">${c}</span><span class="t-dim">— ${d}</span></div>`
                );
            });
            spacer();
        },

        whoami() {
            spacer();
            appendLine(`<span class="t-purple t-bold">// ${escHTML(DATA.name)}</span>`);
            appendLine(`<span class="t-dim">${escHTML(DATA.role)}</span>`);
            appendLine(`<span class="t-dim">📍 ${escHTML(DATA.location)}</span>`);
            spacer();
            appendLine(`<span class="t-output">${escHTML(DATA.bio)}</span>`);
            spacer();
        },

        skills() {
            spacer();
            appendLine(`<span class="t-info t-bold">// Tech Stack</span>`);
            spacer();
            Object.entries(SKILLS).forEach(([cat, items]) => {
                appendLine(`<div><span class="t-purple">[${cat}]</span></div>`);
                appendLine(`<div class="t-block t-dim">→ ${items.join("  ·  ")}</div>`);
                appendLine('<div style="height:4px"></div>');
            });
            spacer();
        },

        projects() {
            spacer();
            appendLine(`<span class="t-info t-bold">// Selected Projects</span>`);
            spacer();
            PROJECTS.forEach((p, i) => {
                appendLine(
                    `<div><span class="t-success">[${i + 1}]</span> <span class="t-bold">${escHTML(p.name)}</span></div>`
                );
                appendLine(`<div class="t-block t-dim">${escHTML(p.stack)}</div>`);
                appendLine(`<div class="t-block t-output">${escHTML(p.desc)}</div>`);
                appendLine('<div style="height:6px"></div>');
            });
            spacer();
        },

        experience() {
            spacer();
            appendLine(`<span class="t-info t-bold">// Work History</span>`);
            spacer();
            EXPERIENCE.forEach((e) => {
                appendLine(
                    `<div><span class="t-purple">▸</span> <span class="t-bold">${escHTML(e.role)}</span></div>`
                );
                appendLine(
                    `<div class="t-block t-dim" style="font-size:0.75rem">${escHTML(e.period)}</div>`
                );
                appendLine(`<div class="t-block t-output">→ ${escHTML(e.desc)}</div>`);
                appendLine('<div style="height:6px"></div>');
            });
            spacer();
        },

        availability() {
            spacer();
            appendLine(`<span class="t-info t-bold">// Status</span>`);
            spacer();
            appendLine(`<div><span class="t-purple">▸</span> <span class="t-dim">Open to    </span><span class="t-success">Freelance projects, Full-time roles</span></div>`);
            appendLine(`<div><span class="t-purple">▸</span> <span class="t-dim">Response   </span><span class="t-success">&lt; 24 hours</span></div>`);
            appendLine(`<div><span class="t-purple">▸</span> <span class="t-dim">Timezone   </span><span class="t-success">WIB (UTC+7)</span></div>`);
            appendLine(`<div><span class="t-purple">▸</span> <span class="t-dim">Contact    </span><span class="t-success">${escHTML(DATA.email)}</span></div>`);
            spacer();
        },

        contact() {
            spacer();
            appendLine(`<span class="t-info t-bold">// Let's build something</span>`);
            spacer();
            appendLine(`<div><span class="t-dim">email   </span><span class="t-success">${escHTML(DATA.email)}</span></div>`);
            SOCIALS.forEach((s) => {
                const label = s.name.padEnd(8);
                appendLine(
                    `<div><span class="t-dim">${escHTML(label)}</span><span class="t-success">${escHTML(s.href)}</span></div>`
                );
            });
            spacer();
        },

        motto() {
            spacer();
            appendLine(`<span class="t-purple t-bold">// Engineering Philosophy</span>`);
            spacer();
            const quotes = [
                '"Ship it. Then make it better."',
                '"Code that no one uses is just an expensive hobby."',
                '"Reliability is a feature. Treat it like one."',
            ];
            quotes.forEach((q) =>
                appendLine(`<div class="t-dim" style="padding-left:.5rem">${escHTML(q)}</div>`)
            );
            spacer();
        },

        secret() {
            spacer();
            appendLine(`<span class="t-success">✨ You found the easter egg!</span>`);
            appendLine(`<span class="t-dim">Fun fact: Built at 2AM. Deployed at 3AM. Debugged at 4AM.</span>`);
            appendLine(`<span class="t-dim">No heavy libraries. Just raw craftsmanship. ✨</span>`);
            spacer();
        },

        clear() {
            if (output) output.innerHTML = "";
        },
    };

    // ── Boot message ──────────────────────────────────────────────
    function boot() {
        appendLine(
            `<span class="t-success t-bold">ismail.portfolio v2.0.0 (Cloud Shell) — type 'help' to run due diligence.</span>`
        );
        appendLine(
            `<span class="t-dim">Type <span class="t-success">help</span> to see available commands. Press <span class="t-info">Esc</span> to close drawer.</span>`
        );
        spacer();
    }

    // ── Execute command ───────────────────────────────────────────
    function execute(raw: string) {
        const cmd = raw.trim().toLowerCase();
        if (!cmd) return;

        printCmd(raw.trim());

        if (commands[cmd]) {
            commands[cmd]();
        } else {
            appendLine(
                `<span class="t-error">bash: ${escHTML(cmd)}: command not found. Try 'help'.</span>`
            );
            spacer();
        }
    }

    // ── Event Listeners ───────────────────────────────────────────
    if (input) {
        input.addEventListener("keydown", (e: KeyboardEvent) => {
            if (e.key === "Enter") {
                const val = input.value;
                if (val.trim()) {
                    history.unshift(val);
                    histIdx = -1;
                }
                execute(val);
                input.value = "";
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                histIdx = Math.min(histIdx + 1, history.length - 1);
                input.value = history[histIdx] ?? "";
            } else if (e.key === "ArrowDown") {
                e.preventDefault();
                histIdx = Math.max(histIdx - 1, -1);
                input.value = histIdx >= 0 ? history[histIdx] : "";
            } else if (e.key === "Tab") {
                e.preventDefault();
                const partial = input.value.toLowerCase();
                const match = Object.keys(commands).find((c) =>
                    c.startsWith(partial)
                );
                if (match) input.value = match;
            }
        });
    }

    // Click inside body -> focus input
    body?.addEventListener("click", () => input?.focus());

    // Titlebar double click or click to toggle minimize
    titlebar?.addEventListener("click", (e) => {
        // If clicking on control buttons, let button handler handle it
        if ((e.target as HTMLElement).closest(".term-action-btn")) return;
        if (drawer?.classList.contains("is-minimized")) {
            toggleMinimize();
        }
    });

    minimizeBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMinimize();
    });

    maximizeBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMaximize();
    });

    closeBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        closeTerminal();
    });

    // Global keyboard shortcuts: Ctrl + ` to toggle, Esc to close
    window.addEventListener("keydown", (e: KeyboardEvent) => {
        if ((e.ctrlKey || e.metaKey) && (e.key === "`" || e.code === "Backquote")) {
            e.preventDefault();
            toggleTerminal();
        } else if (e.key === "Escape" && drawer?.classList.contains("is-open")) {
            e.preventDefault();
            closeTerminal();
        }
    });

    // Custom event interface for other components (e.g. Navbar)
    window.addEventListener("toggle-terminal", () => toggleTerminal());
    window.addEventListener("open-terminal", () => openTerminal());
    window.addEventListener("close-terminal", () => closeTerminal());
</script>
