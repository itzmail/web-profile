---
import { apiFetch } from "../utils/api";
import type { ApiProject } from "../types/index";

const apiProjects = await apiFetch<ApiProject[]>("/projects/highlighted");
const projects = apiProjects ?? [];

const typeLabel: Record<string, string> = { production: 'Prod App', client_work: 'Client', side_project: 'Side', open_source: 'OSS' };
const typeColors: Record<string, string> = {
    production: 'var(--green)',
    client_work: 'var(--cyan)',
    side_project: 'var(--text-muted)',
    open_source: 'var(--purple)',
};
---

<section class="section" id="projects">
    <div class="container">
        <div class="section-header reveal">
            <div class="section-header-text">
                <p class="section-label">portfolio</p>
                <h2 class="section-title">Selected <span>Projects</span></h2>
            </div>
            {projects.length > 0 && (
                <div class="carousel-nav" aria-label="Carousel navigation">
                    <button
                        type="button"
                        id="carouselPrevBtn"
                        class="carousel-nav-btn font-mono"
                        aria-label="Previous projects"
                        disabled
                    >
                        ←
                    </button>
                    <button
                        type="button"
                        id="carouselNextBtn"
                        class="carousel-nav-btn font-mono"
                        aria-label="Next projects"
                    >
                        →
                    </button>
                </div>
            )}
        </div>

        {projects.length === 0 ? (
            <p class="text-muted font-mono" style="font-size:0.875rem;">No projects yet.</p>
        ) : (
            <div class="carousel-wrapper">
            <div class="projects-carousel">
                {projects.map((p, i) => {
                    const slug = p.web_profile?.data?.slug ?? "";
                    const accent = p.web_profile?.data?.accent ?? "var(--green)";
                    const stack = p.web_profile?.data?.stack ?? [];
                    const images = p.web_profile?.data?.images ?? [];
                    const pType = p.web_profile?.data?.project_type ?? 'side_project';
                    const thumb = p.web_profile?.data?.cover_image ?? images[0] ?? null;

                    return (
                        <a
                            href={`/projects/${slug}`}
                            class="project-card reveal"
                            style={`--accent: ${accent};`}
                        >
                            {thumb && (
                                <div class="project-thumb">
                                    <img src={thumb} alt={p.title} loading="lazy" />
                                </div>
                            )}
                            <div class="project-num">{String(i + 1).padStart(2, "0")}</div>
                            <div class="project-body">
                                <div class="project-top">
                                    <div>
                                        <p class="project-slug font-mono text-muted">{slug}.ts</p>
                                        <h3 class="project-name">{p.title}</h3>
                                    </div>
                                    <div class="project-badges font-mono">
                                        <span class="badge badge--type" style={typeColors[pType] ? `color: ${typeColors[pType]};` : ''}>{typeLabel[pType] ?? pType}</span>
                                    </div>
                                </div>
                                <p class="project-desc">{p.description}</p>
                                <div class="project-tags">
                                    {stack.map((tag) => (
                                        <span class="tag">{tag}</span>
                                    ))}
                                </div>
                            </div>
                            <div class="project-accent-bar" />
                        </a>
                    );
                })}
            </div>
            </div>
        )}

        <div class="view-all-wrapper reveal">
            <a href="/projects" class="view-all-btn font-mono">
                View All Projects →
            </a>
        </div>
    </div>
</section>

<style>
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-bottom: 3.5rem;
    }

    .carousel-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
    }

    .carousel-nav-btn {
        width: 2.25rem;
        height: 2.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text-muted);
        font-size: 1rem;
        cursor: pointer;
        transition: all var(--duration) var(--ease);
        user-select: none;
    }

    .carousel-nav-btn:hover:not(:disabled) {
        color: var(--green);
        border-color: var(--green);
        background: rgba(0, 255, 136, 0.08);
        box-shadow: 0 0 12px rgba(0, 255, 136, 0.15);
    }

    .carousel-nav-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
        border-color: var(--border);
        box-shadow: none;
    }

    .carousel-wrapper {
        position: relative;
        margin: 0 calc(-1 * clamp(1.5rem, 5vw, 3rem));
    }

    .carousel-wrapper::before,
    .carousel-wrapper::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 1.25rem;
        width: clamp(1.5rem, 5vw, 3rem);
        z-index: 2;
        pointer-events: none;
        transition: opacity 0.3s var(--ease), visibility 0.3s var(--ease);
    }

    .carousel-wrapper::before {
        left: 0;
        background: linear-gradient(to right, var(--bg), transparent);
        opacity: 0;
        visibility: hidden;
    }

    .carousel-wrapper.has-scroll-left::before {
        opacity: 1;
        visibility: visible;
    }

    .carousel-wrapper::after {
        right: 0;
        background: linear-gradient(to left, var(--bg), transparent);
        opacity: 1;
        visibility: visible;
    }

    .carousel-wrapper.is-scroll-end::after {
        opacity: 0;
        visibility: hidden;
    }

    .projects-carousel {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        overflow-y: visible;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding: 12px clamp(1.5rem, 5vw, 3rem) 1.25rem;
        scrollbar-width: none;
    }

    .projects-carousel::-webkit-scrollbar {
        display: none;
    }

    .project-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-decoration: none;
        color: inherit;
        scroll-snap-align: start;
        flex: 0 0 300px;
        min-height: 240px;
    }

    .project-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at top right,
            rgba(var(--accent-rgb, 0, 255, 136), 0.06),
            transparent 60%
        );
        opacity: 0;
        transition: opacity 0.35s var(--ease);
    }

    .project-card:hover {
        border-color: var(--accent);
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
        color: inherit;
    }

    .project-card:hover::before {
        opacity: 1;
    }

    .project-thumb {
        width: 100%;
        height: 160px;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: -0.25rem;
        flex-shrink: 0;
    }

    .project-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s var(--ease);
    }

    .project-card:hover .project-thumb img {
        transform: scale(1.04);
    }

    .project-accent-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--accent), transparent);
        opacity: 0;
        transition: opacity 0.35s var(--ease);
    }

    .project-card:hover .project-accent-bar {
        opacity: 1;
    }

    .project-num {
        font-family: var(--font-mono);
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--accent);
        opacity: 0.12;
        line-height: 1;
        transition: opacity 0.3s var(--ease);
        user-select: none;
    }

    .project-card:hover .project-num {
        opacity: 0.25;
    }

    .project-body {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        flex: 1;
    }

    .project-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }

    .project-slug {
        font-size: 0.7rem;
        margin-bottom: 0.25rem;
    }

    .project-name {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
    }

    .project-badges {
        display: flex;
        gap: 0.35rem;
        align-items: flex-start;
        flex-shrink: 0;
    }

    .badge {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        padding: 0.18rem 0.45rem;
        border-radius: 4px;
        font-weight: 600;
        letter-spacing: 0.04em;
        white-space: nowrap;
        background: var(--badge-type-bg);
        border: 1px solid var(--badge-type-border);
    }

    .badge--oss {
        background: rgba(0, 255, 136, 0.1);
        color: var(--green);
        border: 1px solid rgba(0, 255, 136, 0.2);
    }

    :global([data-theme="light"]) .badge--oss {
        background: rgba(0, 170, 85, 0.1);
        color: var(--green);
        border: 1px solid rgba(0, 170, 85, 0.25);
    }

    .badge--type {
        background: var(--badge-type-bg);
        color: var(--text-muted);
        border: 1px solid var(--badge-type-border);
    }

    .view-all-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 2.5rem;
    }

    .view-all-btn {
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        color: var(--green);
        text-decoration: none;
        border: 1px solid rgba(0, 255, 136, 0.3);
        border-radius: 8px;
        padding: 0.6rem 1.5rem;
        transition: background 0.2s, border-color 0.2s;
    }

    .view-all-btn:hover {
        background: rgba(0, 255, 136, 0.06);
        border-color: var(--green);
    }

    .project-desc {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.65;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: auto;
    }

    .tag {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--badge-text);
        background: var(--badge-bg);
        border: 1px solid var(--badge-border);
        border-radius: 4px;
        padding: 0.2rem 0.55rem;
        transition: color var(--duration) var(--ease), border-color var(--duration) var(--ease), background var(--duration) var(--ease);
    }

    .project-card:hover .tag {
        color: var(--badge-text-hover);
        background: var(--badge-bg-hover);
        border-color: var(--badge-border-hover);
    }

    @media (max-width: 768px) {
        .project-card {
            flex: 0 0 260px;
        }

        .project-card:hover {
            transform: none;
        }

        .carousel-wrapper::before,
        .carousel-wrapper::after {
            width: clamp(1.5rem, 5vw, 2.5rem);
        }
    }
</style>

<script>
    function initProjectsCarousel() {
        const wrapper = document.querySelector(".carousel-wrapper");
        const carousel = document.querySelector(".projects-carousel");
        const prevBtn = document.getElementById("carouselPrevBtn") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("carouselNextBtn") as HTMLButtonElement | null;
        if (!wrapper || !carousel) return;

        const updateScroll = () => {
            const hasScrollLeft = carousel.scrollLeft > 6;
            const isScrollEnd =
                Math.ceil(carousel.scrollLeft + carousel.clientWidth) >=
                carousel.scrollWidth - 10;

            wrapper.classList.toggle("has-scroll-left", hasScrollLeft);
            wrapper.classList.toggle("is-scroll-end", isScrollEnd);

            if (prevBtn) prevBtn.disabled = !hasScrollLeft;
            if (nextBtn) nextBtn.disabled = isScrollEnd;
        };

        const getScrollStep = () => {
            const firstCard = carousel.querySelector<HTMLElement>(".project-card");
            const gap = parseFloat(window.getComputedStyle(carousel).gap) || 24;
            return firstCard ? firstCard.offsetWidth + gap : 324;
        };

        if (prevBtn) {
            prevBtn.addEventListener("click", () => {
                carousel.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", () => {
                carousel.scrollBy({ left: getScrollStep(), behavior: "smooth" });
            });
        }

        carousel.addEventListener("scroll", updateScroll, { passive: true });
        window.addEventListener("resize", updateScroll, { passive: true });
        updateScroll();
    }

    initProjectsCarousel();
    document.addEventListener("astro:page-load", initProjectsCarousel);
</script>
