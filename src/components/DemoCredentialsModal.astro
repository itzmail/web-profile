---
import type { DemoAccess } from "../types/index";

interface Props {
    demo: DemoAccess;
    projectTitle: string;
}

const { demo, projectTitle } = Astro.props;
const accounts = Array.isArray(demo.accounts) ? demo.accounts : [];
const hasUrl = Boolean(demo.url);
---

<dialog
    id="demoModal"
    class="demo-modal"
    aria-labelledby="demoModalTitle"
>
    <div class="demo-modal-content">
        <!-- Header -->
        <div class="demo-modal-header">
            <div class="demo-modal-heading">
                <span class="demo-modal-subtitle font-mono">
                    // demo access
                </span>
                <h3 id="demoModalTitle" class="demo-modal-title">
                    {projectTitle}
                </h3>
            </div>
            <div class="demo-modal-actions">
                {hasUrl && (
                    <a
                        href={demo.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-sm btn-primary"
                    >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                            <polyline points="15,3 21,3 21,9"/>
                            <line x1="10" y1="14" x2="21" y2="3"/>
                        </svg>
                        Open Demo App
                    </a>
                )}
                <button
                    type="button"
                    class="btn btn-sm btn-ghost demo-modal-close"
                    id="demoModalClose"
                    aria-label="Close modal"
                >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Body -->
        <div class="demo-modal-body">
            {demo.notice && (
                <div class="demo-notice font-mono">
                    <span class="demo-notice-prefix">&gt;_</span>
                    {demo.notice}
                </div>
            )}

            {accounts.length > 0 ? (
                <ul class="demo-accounts">
                    {accounts.map((acc) => (
                        <li class="demo-account">
                            <div class="demo-account-head">
                                {acc.role && (
                                    <span class="demo-role font-mono">{acc.role}</span>
                                )}
                                {acc.note && (
                                    <span class="demo-note">{acc.note}</span>
                                )}
                            </div>

                            <div class="demo-field">
                                <span class="demo-field-label font-mono">identifier</span>
                                <code class="demo-field-value">{acc.identifier}</code>
                                <button
                                    type="button"
                                    class="demo-copy font-mono"
                                    data-copy={acc.identifier}
                                    aria-label="Copy identifier"
                                >copy</button>
                            </div>

                            {acc.secret && (
                                <div class="demo-field">
                                    <span class="demo-field-label font-mono">secret</span>
                                    <code class="demo-field-value">{acc.secret}</code>
                                    <button
                                        type="button"
                                        class="demo-copy font-mono"
                                        data-copy={acc.secret}
                                        aria-label="Copy secret"
                                    >copy</button>
                                </div>
                            )}
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="demo-empty font-mono">
                    No credential accounts listed — use the link above.
                </p>
            )}

            <p class="demo-footnote font-mono">
                >_ sandbox credentials — public demo data only.
            </p>
        </div>
    </div>
</dialog>

<style>
    /* ── Demo Modal ──────────────────────────────────── */
    .demo-modal {
        margin: auto;
        padding: 0;
        border: 1px solid var(--border-glow);
        border-radius: 16px;
        background: var(--surface);
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6),
            0 0 48px rgba(0, 255, 136, 0.06);
        color: var(--text);
        width: min(560px, 92vw);
        transform: translateY(20px) scale(0.98);
        opacity: 0;
        transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
    }

    .demo-modal[open] {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    .demo-modal::backdrop {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        opacity: 0;
        transition: opacity 0.3s var(--ease);
    }

    .demo-modal[open]::backdrop {
        opacity: 1;
    }

    :global([data-theme="light"]) .demo-modal {
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18);
    }

    .demo-modal-content {
        display: flex;
        flex-direction: column;
        max-height: 85vh;
        overflow-y: auto;
    }

    .demo-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0;
        flex-wrap: wrap;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
    }

    .demo-modal-heading {
        min-width: 0;
    }

    .demo-modal-subtitle {
        display: block;
        font-size: 0.7rem;
        color: var(--text-dim);
        letter-spacing: 0.08em;
        margin-bottom: 0.25rem;
    }

    .demo-modal-title {
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 260px;
    }

    .demo-modal-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .demo-modal-actions .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* Local btn-sm sizing (no global .btn-sm token) */
    .demo-modal-actions .btn-sm {
        font-size: 0.75rem;
        padding: 0.45rem 0.75rem;
    }

    .demo-modal-close {
        cursor: pointer;
        color: var(--text-muted);
        transition: all var(--duration) var(--ease);
    }

    .demo-modal-close:hover {
        background: rgba(255, 77, 109, 0.12);
        border-color: rgba(255, 77, 109, 0.4);
        color: var(--red);
    }

    .demo-modal-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.25rem 1.5rem 1.5rem;
    }

    .demo-notice {
        font-size: 0.75rem;
        color: var(--text-muted);
        background: var(--badge-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        line-height: 1.5;
    }

    .demo-notice-prefix {
        color: var(--green);
        margin-right: 0.35rem;
    }

    .demo-accounts {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .demo-account {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0.85rem 1rem;
        background: var(--badge-bg);
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .demo-account-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .demo-role {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--green);
        background: var(--green-glow);
        border: 1px solid rgba(0, 255, 136, 0.2);
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
    }

    :global([data-theme="light"]) .demo-role {
        border-color: rgba(0, 170, 85, 0.25);
    }

    .demo-note {
        font-size: 0.75rem;
        color: var(--text-dim);
    }

    .demo-field {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 0;
    }

    .demo-field-label {
        font-size: 0.65rem;
        color: var(--text-dim);
        width: 4.5rem;
        flex-shrink: 0;
    }

    .demo-field-value {
        flex: 1;
        min-width: 0;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.78rem;
        color: var(--cyan);
        background: transparent;
        border: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .demo-copy {
        flex-shrink: 0;
        cursor: pointer;
        font-size: 0.65rem;
        color: var(--text-muted);
        background: var(--badge-bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
        transition: all var(--duration) var(--ease);
    }

    .demo-copy:hover {
        color: var(--green);
        border-color: var(--green);
    }

    .demo-copy.is-copied {
        color: var(--green);
        border-color: var(--green);
    }

    .demo-empty {
        font-size: 0.75rem;
        color: var(--text-dim);
    }

    .demo-footnote {
        font-size: 0.65rem;
        color: var(--text-dim);
        letter-spacing: 0.04em;
    }

    @media (max-width: 480px) {
        .demo-field-label {
            width: auto;
        }

        .demo-field {
            flex-wrap: wrap;
        }
    }
</style>

<script>
    const modal = document.getElementById(
        "demoModal"
    ) as HTMLDialogElement | null;
    const closeBtn = document.getElementById("demoModalClose");

    if (modal) {
        const prevOverflow = document.body.style.overflow;

        function openDemoModal() {
            modal?.showModal();
            document.body.style.overflow = "hidden";
        }

        function closeDemoModal() {
            modal?.close();
            document.body.style.overflow = prevOverflow;
        }

        // Trigger: any [data-open-demo] element
        document.querySelectorAll("[data-open-demo]").forEach((el) => {
            el.addEventListener("click", (e) => {
                e.preventDefault();
                openDemoModal();
            });
        });

        closeBtn?.addEventListener("click", closeDemoModal);

        // Close on backdrop click (outside content)
        modal.addEventListener("click", (e) => {
            const rect = modal.getBoundingClientRect();
            if (
                e.clientX < rect.left ||
                e.clientX > rect.right ||
                e.clientY < rect.top ||
                e.clientY > rect.bottom
            ) {
                closeDemoModal();
            }
        });

        // Close on Esc (native 'cancel' event on <dialog>)
        modal.addEventListener("cancel", (e) => {
            e.preventDefault();
            closeDemoModal();
        });

        // Safety: always restore scroll when dialog closes any way
        modal.addEventListener("close", () => {
            document.body.style.overflow = prevOverflow;
        });

        // ── 1-Click Copy with visual feedback ──────────────────
        modal.querySelectorAll<HTMLButtonElement>(".demo-copy").forEach((btn) => {
            const original = btn.textContent;
            btn.addEventListener("click", async () => {
                const value = btn.dataset.copy ?? "";
                try {
                    await navigator.clipboard.writeText(value);
                } catch {
                    // Fallback for non-secure contexts
                    const ta = document.createElement("textarea");
                    ta.value = value;
                    ta.style.position = "fixed";
                    ta.style.opacity = "0";
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand("copy");
                    ta.remove();
                }
                btn.textContent = "copied!";
                btn.classList.add("is-copied");
                setTimeout(() => {
                    btn.textContent = original;
                    btn.classList.remove("is-copied");
                }, 1200);
            });
        });
    }
</script>
