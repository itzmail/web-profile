---
import { apiFetch } from "../../utils/api";
import type { ApiProject } from "../../types/index";

interface Props {
	projects?: ApiProject[];
}

const t0 = Date.now();
const projects: ApiProject[] =
	Astro.props.projects ?? (await apiFetch<ApiProject[]>("/projects/highlighted")) ?? [];
const fetchMs = Math.max(12, Date.now() - t0);
---

<section class="v2-section" id="v2-works" data-v2-async-box data-fetch-ms={fetchMs} data-item-count={projects.length}>
	<div class="v2-section-header">
		<h2 class="v2-section-title">
			<span>SELECTED WORKS</span>
		</h2>
		<a href="/projects" class="v2-section-link">[all projects →]</a>
	</div>

	<div class="v2-window">
		<div class="v2-window-titlebar">
			<span>endpoint // GET /projects/highlighted</span>
			<span class="v2-box-telemetry" data-box-status>
				<span data-box-spinner>⠋</span>
				<span data-box-label>SYNCING...</span>
			</span>
		</div>

		<!-- Retro Per-Box Dither Loading Skeleton (shown briefly during stream/hydrate) -->
		<div class="v2-works-skeleton" data-box-skeleton>
			{[1, 2, 3, 4].map((num) => (
				<div class="v2-work-row v2-work-row-skeleton">
					<div class="v2-work-row-left">
						<span class="v2-skeleton-bar v2-thumb-skeleton"></span>
						<div class="v2-work-info">
							<span class="v2-skeleton-bar" style={`width: ${140 + (num % 2) * 50}px; height: 14px;`}></span>
							<span class="v2-skeleton-bar" style={`width: ${220 + (num % 3) * 40}px; height: 10px; margin-top: 4px;`}></span>
						</div>
					</div>
					<div class="v2-work-row-right">
						<span class="v2-skeleton-bar" style="width: 52px; height: 18px;"></span>
						<span class="v2-skeleton-bar" style="width: 58px; height: 18px;"></span>
					</div>
				</div>
			))}
		</div>

		<!-- Loaded Content -->
		<div class="v2-works-directory" data-box-content hidden>
			{projects.map((p) => {
				const data = p.web_profile?.data;
				const slug = data?.slug || p.id;
				const stack = (data?.stack ?? []).slice(0, 4);
				const thumb = data?.cover_image ?? data?.images?.[0] ?? null;

				return (
					<a href={`/projects/${slug}`} class="v2-work-row">
						<div class="v2-work-row-left">
							{thumb ? (
								<div class="v2-work-thumb-frame">
									<img
										src={thumb}
										alt={p.title}
										class="v2-work-thumb-img"
										loading="lazy"
										width="80"
										height="50"
									/>
									<span class="v2-thumb-scanline" aria-hidden="true"></span>
								</div>
							) : (
								<div class="v2-work-thumb-frame v2-work-thumb-fallback">
									<span class="v2-thumb-pixel-icon">&gt;_</span>
								</div>
							)}
							<div class="v2-work-info">
								<span class="v2-work-name">{p.title}</span>
								<span class="v2-work-summary">{p.description}</span>
							</div>
						</div>

						<div class="v2-work-row-right">
							<div class="v2-work-tags">
								{stack.map((tech) => (
									<span class="v2-tag">{tech}</span>
								))}
							</div>
							<span class="v2-work-arrow">→</span>
						</div>
					</a>
				);
			})}
		</div>
	</div>
</section>

<style>
	.v2-works-directory,
	.v2-works-skeleton {
		display: flex;
		flex-direction: column;
	}

	.v2-works-directory[hidden],
	.v2-works-skeleton[hidden] {
		display: none;
	}

	.v2-work-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--v2-border);
		transition: background 0.12s ease;
	}

	.v2-work-row:last-child {
		border-bottom: none;
	}

	.v2-work-row:hover {
		background: var(--v2-bg-elevated);
	}

	.v2-work-row:hover .v2-work-name,
	.v2-work-row:hover .v2-work-arrow {
		color: var(--v2-green);
	}

	.v2-work-row-left {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
		flex: 1;
	}

	.v2-work-idx {
		font-size: 0.72rem;
		color: var(--v2-text-dim);
		font-weight: 600;
		flex-shrink: 0;
	}

	/* Retro 1-bit Micro-Thumbnail (80x50) */
	.v2-work-thumb-frame {
		position: relative;
		width: 76px;
		height: 48px;
		flex-shrink: 0;
		border: 1px solid var(--v2-border-strong);
		background: var(--v2-bg);
		overflow: hidden;
	}

	.v2-work-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: grayscale(85%) contrast(110%);
		transition: filter 0.15s ease, transform 0.15s ease;
	}

	.v2-work-row:hover .v2-work-thumb-img {
		filter: grayscale(0%) contrast(100%);
		transform: scale(1.05);
	}

	.v2-thumb-scanline {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			rgba(18, 16, 16, 0) 50%,
			rgba(0, 0, 0, 0.25) 50%
		);
		background-size: 100% 2px;
		pointer-events: none;
		opacity: 0.6;
	}

	.v2-work-thumb-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--v2-bg-elevated);
	}

	.v2-thumb-pixel-icon {
		font-family: var(--v2-font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--v2-text-dim);
	}

	.v2-thumb-skeleton {
		width: 76px;
		height: 48px;
		flex-shrink: 0;
	}

	.v2-work-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.v2-work-name {
		font-family: var(--v2-font-display);
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--v2-text);
		transition: color 0.12s ease;
	}

	.v2-work-summary {
		font-size: 0.76rem;
		color: var(--v2-text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 52ch;
	}

	.v2-work-row-right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.v2-work-tags {
		display: flex;
		gap: 0.3rem;
	}

	.v2-work-arrow {
		font-size: 0.85rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease, transform 0.12s ease;
	}

	.v2-work-row:hover .v2-work-arrow {
		transform: translateX(2px);
	}

	@media (max-width: 680px) {
		.v2-work-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.65rem;
		}
		.v2-work-row-left {
			width: 100%;
			align-items: center;
			gap: 0.65rem;
		}
		.v2-work-thumb-frame,
		.v2-thumb-skeleton {
			width: 60px;
			height: 38px;
		}
		.v2-work-summary {
			white-space: normal;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
		}
		.v2-work-row-right {
			width: 100%;
			justify-content: space-between;
			padding-left: calc(0.72rem + 60px + 0.65rem);
		}
	}
</style>
