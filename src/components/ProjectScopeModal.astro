---
import CloseIcon from "../assets/icons/CloseIcon.astro";
import MailIcon from "../assets/icons/MailIcon.astro";

// Project scope options
const projectTypes = [
    "Backend / API",
    "Web App (Fullstack)",
    "Mobile App",
    "Security & Audit",
    "Consultation",
];
const timelines = ["ASAP / Urgent", "1 - 2 Months", "Flexible"];
const currencies = ["Rp", "$", "€"];
---

<dialog
    id="scope-modal"
    class="scope-modal"
    aria-labelledby="scope-modal-title"
>
    <div class="scope-modal-content">
        <!-- Header -->
        <div class="scope-modal-header">
            <div>
                <span class="scope-modal-subtitle font-mono">
                    // project scope inquiry
                </span>
                <h3 id="scope-modal-title" class="scope-modal-title">
                    Start a Project
                </h3>
            </div>
            <button
                type="button"
                id="scopeModalClose"
                class="scope-modal-close"
                aria-label="Close modal"
            >
                <CloseIcon width="20" height="20" />
            </button>
        </div>

        <!-- Body: Intake Form -->
        <div class="scope-modal-body">
            <form class="scope-form" id="scopeForm" novalidate>
                <!-- Project Type (multi-select chips) -->
                <fieldset class="scope-field">
                    <legend class="scope-label font-mono">
                        Project Type <span class="scope-hint">(multi-select)</span>
                    </legend>
                    <div class="chip-group" id="typeChips" role="group" aria-label="Project type">
                        {projectTypes.map((t) => (
                            <button
                                type="button"
                                class="chip"
                                data-value={t}
                                aria-pressed="false"
                            >
                                {t}
                            </button>
                        ))}
                    </div>
                </fieldset>

                <!-- Timeline (single-select chips) -->
                <fieldset class="scope-field">
                    <legend class="scope-label font-mono">Timeline</legend>
                    <div class="chip-group" id="timeChips" role="group" aria-label="Timeline">
                        {timelines.map((t) => (
                            <button
                                type="button"
                                class="chip"
                                data-value={t}
                                aria-pressed="false"
                            >
                                {t}
                            </button>
                        ))}
                    </div>
                </fieldset>

                <!-- Budget (optional) -->
                <fieldset class="scope-field">
                    <legend class="scope-label font-mono">
                        Estimated Budget <span class="scope-hint">(Optional)</span>
                    </legend>
                    <div class="budget-row">
                        <select
                            id="budgetCurrency"
                            class="budget-currency"
                            aria-label="Currency"
                        >
                            {currencies.map((c) => (
                                <option value={c} selected={c === "Rp"}>
                                    {c}
                                </option>
                            ))}
                        </select>
                        <input
                            type="text"
                            id="budgetAmount"
                            class="scope-input"
                            placeholder="e.g. 15.000.000 atau 2,500"
                            autocomplete="off"
                        />
                    </div>
                </fieldset>

                <!-- Required inputs -->
                <div class="scope-field">
                    <label class="scope-label font-mono" for="senderName">
                        Name
                    </label>
                    <input
                        type="text"
                        id="senderName"
                        class="scope-input"
                        placeholder="Your name"
                        autocomplete="name"
                        required
                    />
                    <p class="field-error" id="nameError" hidden>
                        Min 2 characters.
                    </p>
                </div>

                <div class="scope-field">
                    <label class="scope-label font-mono" for="senderEmail">
                        Email
                    </label>
                    <input
                        type="email"
                        id="senderEmail"
                        class="scope-input"
                        placeholder="you@company.com"
                        autocomplete="email"
                        required
                    />
                    <p class="field-error" id="emailError" hidden>
                        Enter a valid email.
                    </p>
                </div>

                <div class="scope-field">
                    <label class="scope-label font-mono" for="senderMessage">
                        Project Brief
                    </label>
                    <textarea
                        id="senderMessage"
                        class="scope-input scope-textarea"
                        placeholder="What are you building? Scope, goals, links — anything helps."
                        rows="4"
                        required
                    ></textarea>
                    <p class="field-error" id="messageError" hidden>
                        Min 10 characters.
                    </p>
                </div>

                <button
                    type="submit"
                    class="btn btn-primary scope-submit"
                    id="scopeSubmit"
                >
                    <MailIcon width="16" height="16" />
                    Send Project Inquiry
                </button>
                <p class="scope-note font-mono">
                    >_ opens your email client — no data stored.
                </p>
            </form>
        </div>
    </div>
</dialog>

<style>
    /* ── Scope Modal ─────────────────────────────────── */
    .scope-modal {
        margin: auto;
        padding: 0;
        border: 1px solid var(--border-glow);
        border-radius: 16px;
        background: var(--surface);
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6),
            0 0 0 1px rgba(255, 255, 255, 0.05),
            0 0 48px rgba(0, 255, 136, 0.06);
        color: var(--text);
        width: 90%;
        max-width: 560px;
        transform: translateY(20px) scale(0.98);
        opacity: 0;
        transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
    }

    .scope-modal[open] {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    .scope-modal::backdrop {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        opacity: 0;
        transition: opacity 0.3s var(--ease);
    }

    .scope-modal[open]::backdrop {
        opacity: 1;
    }

    .scope-modal-content {
        display: flex;
        flex-direction: column;
        max-height: 85vh;
        overflow: hidden;
    }

    .scope-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-shrink: 0;
        padding: 1.5rem 1.5rem 1.25rem;
        border-bottom: 1px solid var(--border);
    }

    .scope-modal-subtitle {
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        color: var(--green);
    }

    .scope-modal-title {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.2;
        margin-top: 0.25rem;
    }

    .scope-modal-close {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
        cursor: pointer;
        padding: 0.375rem;
        border-radius: 8px;
        transition: all var(--duration) var(--ease);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .scope-modal-close:hover {
        background: rgba(255, 77, 109, 0.12);
        border-color: rgba(255, 77, 109, 0.4);
        color: var(--red);
    }

    .scope-modal-body {
        font-size: 0.875rem;
        line-height: 1.6;
        overflow-y: auto;
        flex: 1;
        min-height: 0;
        padding: 1.5rem;
    }

    .scope-modal-body::-webkit-scrollbar {
        width: 6px;
    }
    .scope-modal-body::-webkit-scrollbar-track {
        background: transparent;
    }
    .scope-modal-body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
    }

    /* ── Form ────────────────────────────────────────── */
    .scope-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .scope-form fieldset {
        border: none;
        margin: 0;
        padding: 0;
        min-width: 0;
    }

    .scope-label {
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--text);
        margin-bottom: 0.65rem;
        display: block;
    }

    .scope-hint {
        color: var(--text-dim);
        letter-spacing: 0;
        font-size: 0.7rem;
    }

    /* Chips */
    .chip-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .chip {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        background: var(--badge-bg);
        border: 1px solid var(--badge-border);
        border-radius: 999px;
        padding: 0.4rem 0.85rem;
        cursor: pointer;
        transition: all var(--duration) var(--ease);
    }

    .chip:hover {
        color: var(--text);
        border-color: var(--badge-border-hover);
        background: var(--badge-bg-hover);
    }

    .chip[aria-pressed="true"] {
        color: var(--bg);
        background: var(--green);
        border-color: var(--green);
        box-shadow: 0 0 12px rgba(0, 255, 136, 0.35);
        font-weight: 600;
    }

    /* Budget */
    .budget-row {
        display: flex;
        gap: 0.5rem;
    }

    .budget-currency {
        width: 76px;
        flex-shrink: 0;
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        padding: 0.65rem 0.5rem;
        cursor: pointer;
        outline: none;
        transition: border-color var(--duration) var(--ease);
    }

    .budget-currency:focus {
        border-color: var(--green);
    }

    .scope-input {
        width: 100%;
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        padding: 0.65rem 0.85rem;
        outline: none;
        transition: border-color var(--duration) var(--ease),
            box-shadow var(--duration) var(--ease);
    }

    .scope-input::placeholder {
        color: var(--text-dim);
    }

    .scope-input:focus {
        border-color: var(--green);
        box-shadow: 0 0 0 3px rgba(0, 255, 136, 0.08);
    }

    .scope-textarea {
        resize: vertical;
        min-height: 96px;
        line-height: 1.6;
    }

    .scope-input.is-invalid {
        border-color: var(--red);
        box-shadow: 0 0 0 3px rgba(255, 77, 109, 0.12);
    }

    .field-error {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--red);
        margin-top: 0.4rem;
    }

    /* Submit */
    .scope-submit {
        font-size: 0.875rem;
    }

    .scope-submit:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .scope-note {
        font-size: 0.65rem;
        color: var(--text-dim);
        letter-spacing: 0.04em;
        text-align: center;
    }

    @media (max-width: 480px) {
        .budget-row {
            flex-direction: column;
        }

        .budget-currency {
            width: 100%;
        }
    }
</style>

<script>
    const modal = document.getElementById(
        "scope-modal"
    ) as HTMLDialogElement | null;
    const closeBtn = document.getElementById("scopeModalClose");
    const form = document.getElementById("scopeForm") as HTMLFormElement | null;
    const typeChipsWrap = document.getElementById("typeChips");
    const timeChipsWrap = document.getElementById("timeChips");
    const budgetCurrency = document.getElementById(
        "budgetCurrency"
    ) as HTMLSelectElement | null;
    const budgetAmount = document.getElementById(
        "budgetAmount"
    ) as HTMLInputElement | null;
    const nameInput = document.getElementById(
        "senderName"
    ) as HTMLInputElement | null;
    const emailInput = document.getElementById(
        "senderEmail"
    ) as HTMLInputElement | null;
    const messageInput = document.getElementById(
        "senderMessage"
    ) as HTMLTextAreaElement | null;
    const nameError = document.getElementById("nameError");
    const emailError = document.getElementById("emailError");
    const messageError = document.getElementById("messageError");
    const submitBtn = document.getElementById(
        "scopeSubmit"
    ) as HTMLButtonElement | null;

    const RECIPIENT = "ismailnuralam@gmail.com";

    if (modal) {
        // ── Open / Close ───────────────────────────────────────
        function openModal() {
            modal?.showModal();
        }

        function closeModal() {
            modal?.close();
        }

        window.addEventListener("open-scope-modal", openModal);

        closeBtn?.addEventListener("click", closeModal);

        // Close on backdrop click (outside content)
        modal.addEventListener("click", (e) => {
            const rect = modal.getBoundingClientRect();
            if (
                e.clientX < rect.left ||
                e.clientX > rect.right ||
                e.clientY < rect.top ||
                e.clientY > rect.bottom
            ) {
                closeModal();
            }
        });

        // Close on Esc (native 'cancel' event on <dialog>)
        modal.addEventListener("cancel", (e) => {
            e.preventDefault();
            closeModal();
        });

        // ── Chip selection ─────────────────────────────────────
        function getSelected(wrap: HTMLElement | null): string[] {
            if (!wrap) return [];
            return Array.from(
                wrap.querySelectorAll<HTMLButtonElement>(
                    ".chip[aria-pressed='true']"
                )
            ).map((b) => b.dataset.value ?? "");
        }

        typeChipsWrap
            ?.querySelectorAll<HTMLButtonElement>(".chip")
            .forEach((chip) => {
                chip.addEventListener("click", () => {
                    chip.setAttribute(
                        "aria-pressed",
                        chip.getAttribute("aria-pressed") === "true"
                            ? "false"
                            : "true"
                    );
                });
            });

        timeChipsWrap
            ?.querySelectorAll<HTMLButtonElement>(".chip")
            .forEach((chip) => {
                chip.addEventListener("click", () => {
                    const isOn =
                        chip.getAttribute("aria-pressed") === "true";
                    timeChipsWrap
                        .querySelectorAll<HTMLButtonElement>(".chip")
                        .forEach((c) =>
                            c.setAttribute("aria-pressed", "false")
                        );
                    if (!isOn) chip.setAttribute("aria-pressed", "true");
                });
            });

        // ── Validation ─────────────────────────────────────────
        function setError(
            el: HTMLElement | null,
            errEl: HTMLElement | null,
            invalid: boolean
        ) {
            el?.classList.toggle("is-invalid", invalid);
            if (errEl) errEl.hidden = !invalid;
        }

        // ── Submit → structured mailto ─────────────────────────
        form?.addEventListener("submit", (e) => {
            e.preventDefault();
            if (!nameInput || !emailInput || !messageInput) return;

            const name = nameInput.value.trim();
            const email = emailInput.value.trim();
            const message = messageInput.value.trim();
            const types = getSelected(typeChipsWrap);
            const timeline = getSelected(timeChipsWrap)[0] ?? "";

            let valid = true;

            const nameInvalid = name.length < 2;
            setError(nameInput, nameError, nameInvalid);
            valid = valid && !nameInvalid;

            const emailInvalid = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            setError(emailInput, emailError, emailInvalid);
            valid = valid && !emailInvalid;

            const messageInvalid = message.length < 10;
            setError(messageInput, messageError, messageInvalid);
            valid = valid && !messageInvalid;

            if (!valid) return;

            const currency = budgetCurrency?.value ?? "Rp";
            const amount = budgetAmount?.value.trim() ?? "";
            const budget = amount
                ? `${currency} ${amount}`
                : "Not specified";

            const subject = `[Project Inquiry] ${
                types.join(", ") || "General"
            } — ${name}`;
            const body = [
                `Project Type: ${types.join(", ") || "Not specified"}`,
                `Estimated Budget: ${budget}`,
                `Timeline: ${
                    getSelected(timeChipsWrap)[0] || "Not specified"
                }`,
                `Sender: ${name} <${email}>`,
                "",
                "Project Brief:",
                message,
            ].join("\n");

            const mailtoUrl = `mailto:${RECIPIENT}?subject=${encodeURIComponent(
                subject
            )}&body=${encodeURIComponent(body)}`;

            if (submitBtn) submitBtn.disabled = true;
            window.location.href = mailtoUrl;
            setTimeout(() => {
                if (submitBtn) submitBtn.disabled = false;
            }, 1500);
        });
    }
</script>
