---
import { marked } from "marked";
import { apiFetch } from "../../utils/api";
import Layout from "../../layouts/Layout.astro";
import type { ApiProject } from "../../types/index";

const { slug: slugParam } = Astro.params;

const projects = await apiFetch<ApiProject[]>("/projects");
const project = projects?.find(
    (p) => (p.web_profile?.data?.slug ?? p.id) === slugParam
);

if (!project) {
    return Astro.redirect("/404");
}
const data = project.web_profile?.data;
const slug = data?.slug ?? "";
const accent = data?.accent ?? "#00ff88";
const stack = data?.stack ?? [];
const images = data?.images ?? [];
const coverImage = data?.cover_image;
const links = data?.links ?? [];
const rawContent = data?.content ?? "";
const htmlContent = rawContent ? marked(rawContent) : "";
const pType = data?.project_type ?? "side_project";

const typeLabel: Record<string, string> = {
    production: "production app",
    client_work: "client work",
    side_project: "side project",
    open_source: "open source",
};

interface LinkIconDef {
    path: string;
    viewBox: string;
}

const linkIcons: Record<string, LinkIconDef> = {
    github: {
        path: "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z",
        viewBox: "0 0 24 24",
    },
    gitlab: {
        path: "M22.288 9.594l-.23-.599L19.392 1.2a.636.636 0 00-.61-.439.634.634 0 00-.61.44l-2.341 7.2H8.169L5.829 1.2A.635.635 0 005.219.762a.636.636 0 00-.611.44L1.942 8.993l-.229.6A4.524 4.524 0 003.43 14.66L10.44 20l3.559 2.694 2.168 1.639a.732.732 0 00.888 0l2.168-1.64L22.233 20l7.011-5.339a4.524 4.524 0 001.718-5.067",
        viewBox: "0 0 24 24",
    },
    live: {
        path: "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14",
        viewBox: "0 0 24 24",
    },
    playstore: {
        path: "M3.18 23.76c.35.2.77.2 1.14-.02l12.4-7.17-3.08-3.08-10.46 10.27zM.58 1.52C.22 1.84 0 2.36 0 3.04v17.92c0 .68.22 1.2.58 1.52l.08.08 10.03-10.03v-.24L.66 1.44l-.08.08zM20.44 10.4l-2.85-1.65-3.37 3.37 3.37 3.37 2.87-1.66c.82-.47.82-1.24-.02-1.43zM4.32.26L16.72 7.4l-3.08 3.08L3.18.21C3.55-.01 3.97-.01 4.32.26z",
        viewBox: "0 0 24 24",
    },
    googleplay: {
        path: "M3.18 23.76c.35.2.77.2 1.14-.02l12.4-7.17-3.08-3.08-10.46 10.27zM.58 1.52C.22 1.84 0 2.36 0 3.04v17.92c0 .68.22 1.2.58 1.52l.08.08 10.03-10.03v-.24L.66 1.44l-.08.08zM20.44 10.4l-2.85-1.65-3.37 3.37 3.37 3.37 2.87-1.66c.82-.47.82-1.24-.02-1.43zM4.32.26L16.72 7.4l-3.08 3.08L3.18.21C3.55-.01 3.97-.01 4.32.26z",
        viewBox: "0 0 24 24",
    },
    appstore: {
        path: "M 97.905 67.885 c 0.174 18.8 16.494 25.057 16.674 25.137 c -0.138 0.44 -2.607 8.916 -8.597 17.669 c -5.178 7.568 -10.553 15.108 -19.018 15.266 c -8.318 0.152 -10.993 -4.934 -20.504 -4.934 c -9.508 0 -12.479 4.776 -20.354 5.086 c -8.172 0.31 -14.395 -8.185 -19.616 -15.724 C 15.822 94.961 7.669 66.8 18.616 47.791 c 5.438 -9.44 15.158 -15.417 25.707 -15.571 c 8.024 -0.153 15.598 5.398 20.503 5.398 c 4.902 0 14.106 -6.676 23.782 -5.696 c 4.051 0.169 15.421 1.636 22.722 12.324 c -0.587 0.365 -13.566 7.921 -13.425 23.639 M 82.272 21.719 c 4.338 -5.251 7.258 -12.563 6.462 -19.836 c -6.254 0.251 -13.816 4.167 -18.301 9.416 c -4.02 4.647 -7.54 12.087 -6.591 19.216 c 6.971 0.54 14.091 -3.542 18.43 -8.796",
        viewBox: "0 0 122 130",
    },
    apple: {
        path: "M 97.905 67.885 c 0.174 18.8 16.494 25.057 16.674 25.137 c -0.138 0.44 -2.607 8.916 -8.597 17.669 c -5.178 7.568 -10.553 15.108 -19.018 15.266 c -8.318 0.152 -10.993 -4.934 -20.504 -4.934 c -9.508 0 -12.479 4.776 -20.354 5.086 c -8.172 0.31 -14.395 -8.185 -19.616 -15.724 C 15.822 94.961 7.669 66.8 18.616 47.791 c 5.438 -9.44 15.158 -15.417 25.707 -15.571 c 8.024 -0.153 15.598 5.398 20.503 5.398 c 4.902 0 14.106 -6.676 23.782 -5.696 c 4.051 0.169 15.421 1.636 22.722 12.324 c -0.587 0.365 -13.566 7.921 -13.425 23.639 M 82.272 21.719 c 4.338 -5.251 7.258 -12.563 6.462 -19.836 c -6.254 0.251 -13.816 4.167 -18.301 9.416 c -4.02 4.647 -7.54 12.087 -6.591 19.216 c 6.971 0.54 14.091 -3.542 18.43 -8.796",
        viewBox: "0 0 122 130",
    },
    youtube: {
        path: "M19.59 6.69a4.83 4.83 0 01-3.77-2.75 12.65 12.65 0 00-8.45 0A4.83 4.83 0 013.6 6.69 49.17 49.17 0 002 12a49.17 49.17 0 001.6 5.31 4.83 4.83 0 003.77 2.75 12.65 12.65 0 008.45 0 4.83 4.83 0 003.77-2.75A49.17 49.17 0 0022 12a49.17 49.17 0 00-2.41-5.31zM10 15V9l5 3-5 3z",
        viewBox: "0 0 24 24",
    },
};

const mainImage = coverImage ?? images[0];

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: project.title,
    description: project.description,
    creator: { "@type": "Person", name: "Ismail Alam" },
    ...(mainImage && { image: mainImage }),
};
---

<Layout
    title={`${project.title} — Ismail Alam`}
    description={project.description}
    canonicalURL={`https://itsmail.dev/projects/${slug}`}
    image={mainImage}
    jsonLd={jsonLd}
    chatPageContext={{
        type: "project",
        title: project.title,
        description: project.description,
        extra: stack.length > 0 ? `Tech stack: ${stack.join(", ")}` : undefined,
        body: rawContent,
    }}
>
    <main class="project-detail">
        <div class="container">
            <nav class="breadcrumb">
                <a href="/projects" class="back-link font-mono">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"/>
                    </svg>
                    Back to Projects
                </a>
            </nav>

            <!-- ── Unified Header ── -->
            <header class="project-header reveal">
                <div class="header-main">
                    <p class="project-slug font-mono text-muted">
                        // {typeLabel[pType] ?? pType} &middot; {slug}.ts
                    </p>
                    <h1 class="project-title" style={`--accent: ${accent}`}>
                        {project.title}
                    </h1>
                    {project.description && (
                        <p class="project-description">{project.description}</p>
                    )}
                </div>

                <div class="project-header-meta">
                    {stack.length > 0 && (
                        <div class="tag-list">
                            {stack.map((tag) => (
                                <span class="tag font-mono">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )}

                    {links.length > 0 && (
                        <div class="links-list">
                            {links.map((link) => {
                                const labelKey = link.label.toLowerCase().replace(/[\s_-]+/g, "");
                                const icon = linkIcons[labelKey] ?? linkIcons[link.label.toLowerCase()] ?? linkIcons.live;
                                const isThemeIcon = ["appstore", "apple", "playstore", "googleplay"].includes(labelKey);
                                return (
                                    <a
                                        href={link.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class={`link-item font-mono ${isThemeIcon ? "link-item--theme-icon" : ""}`}
                                        style={`--accent: ${accent}`}
                                    >
                                        <svg width="14" height="14" viewBox={icon.viewBox} fill="currentColor" class="link-icon">
                                            <path d={icon.path} />
                                        </svg>
                                        <span>{link.label} ↗</span>
                                    </a>
                                );
                            })}
                        </div>
                    )}
                </div>
            </header>

            <!-- ── Hero Cover Banner ── -->
            {coverImage && (
                <div class="hero-cover-banner reveal">
                    <img
                        src={coverImage}
                        alt={`${project.title} cover`}
                        class="banner-img"
                        loading="eager"
                    />
                </div>
            )}

            <!-- ── Screenshots Gallery ── -->
            {images.length > 0 && (
                <div class="image-gallery reveal">
                    <div class="gallery-header">
                        <h2 class="gallery-title font-mono text-muted">// screenshots & preview</h2>
                        {images.length > 1 && (
                            <span class="gallery-hint font-mono text-muted">scroll &rarr; to see more</span>
                        )}
                    </div>
                    <div class="gallery-scroll">
                        {images.map((src, i) => (
                            <div class="gallery-item">
                                <img
                                    src={src}
                                    alt={`${project.title} screenshot ${i + 1}`}
                                    loading={i === 0 ? "eager" : "lazy"}
                                    class="gallery-img"
                                />
                            </div>
                        ))}
                    </div>
                </div>
            )}

            <!-- ── Case Study Article ── -->
            {htmlContent && (
                <article class="project-content reveal" set:html={htmlContent} />
            )}
        </div>
    </main>

    <div class="img-lightbox" id="img-lightbox">
        <img id="img-lightbox-img" src="" alt="" />
    </div>
</Layout>

<style>
    .project-detail {
        padding-top: calc(var(--nav-h) + 3rem);
        padding-bottom: 6rem;
    }

    .breadcrumb {
        margin-bottom: 2rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: color var(--duration) var(--ease);
    }

    .back-link:hover {
        color: var(--green);
    }

    /* ── Unified Header ────────────────────────────── */
    .project-header {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2.75rem;
    }

    .header-main {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .project-slug {
        font-size: 0.8rem;
        letter-spacing: 0.05em;
    }

    .project-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--text);
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .project-description {
        font-size: 1.05rem;
        color: var(--text-muted);
        line-height: 1.7;
        max-width: 75ch;
    }

    .project-header-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
    }

    .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
    }

    .tag {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        background: var(--badge-bg);
        border: 1px solid var(--badge-border);
        border-radius: 4px;
        padding: 0.2rem 0.55rem;
        color: var(--badge-text);
        transition: all var(--duration) var(--ease);
    }

    .tag:hover {
        color: var(--badge-text-hover);
        background: var(--badge-bg-hover);
        border-color: var(--badge-border-hover);
    }

    .links-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .link-item {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.85rem;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--surface);
        font-size: 0.75rem;
        color: var(--text);
        text-decoration: none;
        transition: all var(--duration) var(--ease);
    }

    .link-icon {
        flex-shrink: 0;
        fill: currentColor;
        transition: color var(--duration) var(--ease);
    }

    .link-item:hover {
        color: var(--accent);
        border-color: var(--accent);
        background: rgba(0, 0, 0, 0.4);
        box-shadow: 0 0 16px rgba(var(--accent-rgb, 0, 255, 136), 0.15);
        transform: translateY(-1px);
    }

    /* Apple & Google Play icons: white in dark mode, black in light mode */
    .link-item--theme-icon .link-icon {
        color: #ffffff;
    }

    :global([data-theme="light"]) .link-item--theme-icon .link-icon {
        color: #0d0d1a;
    }

    .link-item--theme-icon:hover .link-icon {
        color: #ffffff;
    }

    :global([data-theme="light"]) .link-item--theme-icon:hover .link-icon {
        color: #0d0d1a;
    }

    /* ── Hero Cover Banner ─────────────────────────── */
    .hero-cover-banner {
        width: 100%;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), 0 0 40px rgba(var(--accent-rgb, 0, 255, 136), 0.08);
        margin-bottom: 3.5rem;
        background: var(--surface);
    }

    .banner-img {
        width: 100%;
        max-height: 480px;
        object-fit: cover;
        display: block;
        cursor: zoom-in;
        transition: transform 0.3s var(--ease);
    }

    .banner-img:hover {
        transform: scale(1.01);
    }

    /* ── Screenshots Gallery ───────────────────────── */
    .image-gallery {
        margin-bottom: 3.5rem;
    }

    .gallery-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .gallery-title {
        font-size: 0.8rem;
        letter-spacing: 0.05em;
    }

    .gallery-hint {
        font-size: 0.75rem;
    }

    .gallery-scroll {
        display: flex;
        gap: 1.25rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 1rem;
        scrollbar-width: thin;
        scrollbar-color: var(--surface-border) transparent;
    }

    .gallery-scroll::-webkit-scrollbar {
        height: 6px;
    }

    .gallery-scroll::-webkit-scrollbar-thumb {
        background: var(--surface-border);
        border-radius: 3px;
    }

    .gallery-item {
        flex: 0 0 auto;
        scroll-snap-align: start;
        height: 460px;
        background: var(--surface);
        border-radius: 12px;
        border: 1px solid var(--border);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }

    .gallery-img {
        height: 100%;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        border-radius: 8px;
        cursor: zoom-in;
        transition: transform 0.25s var(--ease);
    }

    .gallery-img:hover {
        transform: scale(1.02);
    }

    /* ── Case Study Content ────────────────────────── */
    .project-content {
        max-width: 75ch;
        margin: 0 auto;
        line-height: 1.85;
        font-size: 1rem;
        color: var(--text-muted);
    }

    .project-content :global(h1),
    .project-content :global(h2),
    .project-content :global(h3),
    .project-content :global(h4) {
        color: var(--text);
        margin-top: 2.25rem;
        margin-bottom: 0.75rem;
    }

    .project-content :global(h2) {
        font-size: 1.4rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
    }

    .project-content :global(h3) {
        font-size: 1.15rem;
    }

    .project-content :global(p) {
        margin-bottom: 1.25rem;
    }

    .project-content :global(ul),
    .project-content :global(ol) {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
    }

    .project-content :global(li) {
        margin-bottom: 0.4rem;
    }

    .project-content :global(code) {
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1em 0.4em;
        color: var(--green);
    }

    .project-content :global(pre) {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.25rem;
        overflow-x: auto;
        margin-bottom: 1.25rem;
    }

    .project-content :global(pre code) {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.875rem;
    }

    .project-content :global(a) {
        color: var(--green);
        text-decoration: underline;
        text-decoration-color: rgba(0, 255, 136, 0.3);
    }

    .project-content :global(a:hover) {
        text-decoration-color: var(--green);
    }

    .project-content :global(blockquote) {
        border-left: 3px solid var(--green);
        padding-left: 1rem;
        margin: 1.25rem 0;
        color: var(--text-dim);
        font-style: italic;
    }

    .project-content :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
    }

    .project-content :global(img) {
        max-width: 100%;
        border-radius: 8px;
        border: 1px solid var(--border);
        margin: 1.25rem 0;
        cursor: zoom-in;
    }

    /* ── Lightbox ──────────────────────────────────── */
    .img-lightbox {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
        cursor: zoom-out;
    }

    .img-lightbox.open {
        opacity: 1;
        visibility: visible;
    }

    .img-lightbox img {
        max-width: 100%;
        max-height: 100%;
        border-radius: 8px;
        transform: scale(0.95);
        transition: transform 0.2s ease;
    }

    .img-lightbox.open img {
        transform: scale(1);
    }

    @media (max-width: 768px) {
        .gallery-item {
            height: 380px;
        }

        .project-header-meta {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    // image zoom lightbox
    const lightbox = document.getElementById("img-lightbox");
    const lightboxImg = document.getElementById("img-lightbox-img") as HTMLImageElement;
    if (lightbox && lightboxImg) {
        document.querySelectorAll<HTMLImageElement>(".banner-img, .gallery-img, .project-content img").forEach((img) => {
            img.addEventListener("click", () => {
                lightboxImg.src = img.src;
                lightboxImg.alt = img.alt;
                lightbox.classList.add("open");
            });
        });
        const closeLightbox = () => lightbox.classList.remove("open");
        lightbox.addEventListener("click", closeLightbox);
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeLightbox();
        });
    }
</script>
