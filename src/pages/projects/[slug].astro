---
import { marked } from "marked";
import { apiFetch } from "../../utils/api";
import { addImageDimensions, getImageSize } from "../../utils/imageSize";
import LayoutV2 from "../../layouts/LayoutV2.astro";
import CommandBarV2 from "../../components/v2/CommandBarV2.astro";
import DemoCredentialsModal from "../../components/DemoCredentialsModal.astro";
import CvModal from "../../components/CvModal.astro";
import type { ApiProject, ApiSettings, DemoAccess } from "../../types/index";

const { slug: slugParam } = Astro.params;

const t0 = Date.now();
const [projects, settings] = await Promise.all([
	apiFetch<ApiProject[]>("/projects"),
	apiFetch<ApiSettings>("/settings"),
]);
const fetchMs = Math.max(12, Date.now() - t0);

const project = projects?.find(
	(p) => (p.web_profile?.data?.slug ?? p.id) === slugParam,
);

if (!project) {
	return Astro.redirect("/404");
}

const data = project.web_profile?.data;
const slug = data?.slug ?? "";
const stack = Array.isArray(data?.stack) ? data.stack : [];
const images = Array.isArray(data?.images) ? data.images : [];
const coverImage = data?.cover_image;
const allImages = [
	...(coverImage ? [coverImage] : []),
	...images.filter((img) => img !== coverImage),
];
const links = Array.isArray(data?.links) ? data.links : [];
const rawContent = data?.content ?? "";
const [htmlContent, mainSize] = await Promise.all([
	rawContent ? addImageDimensions(await marked(rawContent)) : Promise.resolve(""),
	allImages[0] ? getImageSize(allImages[0]) : Promise.resolve(null),
]);
const pType = data?.project_type ?? "side_project";
const demoAccess: DemoAccess | undefined = data?.demo_access;
const showDemoAccess = Boolean(
	demoAccess?.enabled &&
		(demoAccess.url ||
			(Array.isArray(demoAccess.accounts) && demoAccess.accounts.length > 0)),
);

const typeLabel: Record<string, string> = {
	production: "production app",
	client_work: "client work",
	side_project: "side project",
	open_source: "open source",
};

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: project.title,
	description: project.description,
	applicationCategory: "DeveloperApplication",
	operatingSystem: "Web",
	author: {
		"@type": "Person",
		name: "Ismail Alam",
		url: "https://itsmail.dev",
	},
};
---

<LayoutV2
	title={`${project.title} — Ismail Alam`}
	description={project.description}
	jsonLd={jsonLd}
>
	<main class="v2-container">
		<!-- Back Breadcrumb & Header -->
		<header class="v2-project-header">
			<div class="v2-project-meta-row">
				<a href="/projects" class="v2-back-link">
					<span class="v2-back-arrow">←</span>
					<span>all projects</span>
				</a>
				<span class="v2-project-type-pill">[{typeLabel[pType] ?? pType}]</span>
			</div>

			<h1 class="v2-project-headline">{project.title}</h1>
			{project.description && (
				<p class="v2-project-summary">{project.description}</p>
			)}

			<!-- Tech Stack & Live Action Row -->
			<div class="v2-project-toolbar">
				<div class="v2-project-stack">
					{stack.map((t) => (
						<span class="v2-tag">{t}</span>
					))}
				</div>

				<div class="v2-project-actions">
					{links.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="v2-btn"
						>
							[{link.label} ↗]
						</a>
					))}

					{showDemoAccess && (
						<button
							type="button"
							class="v2-btn v2-btn-primary"
							id="openDemoModalBtn"
							data-open-demo
						>
							[🔑 Demo Access]
						</button>
					)}
				</div>
			</div>
		</header>

		<!-- Visual Gallery Window -->
		{allImages.length > 0 && (
			<section class="v2-window v2-gallery-window" data-v2-async-box data-fetch-ms={fetchMs}>
				<div class="v2-window-titlebar">
					<span>buffer // {slug}-preview.png</span>
					<span class="v2-box-telemetry" data-box-status>
						<span data-box-spinner>⠋</span>
						<span data-box-label>200 OK · {allImages.length} frames</span>
					</span>
				</div>

				<div class="v2-gallery-stage">
					<div class="v2-gallery-main-frame">
						<img
							src={allImages[0]}
							alt={`${project.title} preview`}
							id="v2MainPreviewImg"
							class="v2-gallery-main-img"
							width={mainSize?.width}
							height={mainSize?.height}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="v2-gallery-scanline" aria-hidden="true"></span>
					</div>

					{allImages.length > 1 && (
						<div class="v2-gallery-thumbs" role="group" aria-label="Screenshots thumbnail list">
							{allImages.map((imgUrl, idx) => (
								<button
									type="button"
									class={`v2-thumb-item ${idx === 0 ? "is-active" : ""}`}
									data-img-src={imgUrl}
									aria-label={`0${idx + 1} view image ${idx + 1}`}
								>
									<img src={imgUrl} alt={`Thumbnail ${idx + 1}`} loading="lazy" />
									<span class="v2-thumb-idx">0{idx + 1}</span>
								</button>
							))}
						</div>
					)}
				</div>
			</section>
		)}

		<!-- Deep Technical Architecture Notes -->
		{htmlContent ? (
			<article class="v2-window v2-content-window">
				<div class="v2-window-titlebar">
					<span>spec // architecture.md</span>
					<span class="v2-box-telemetry">
						<span>● 200 OK</span>
					</span>
				</div>
				<div class="v2-markdown-body" set:html={htmlContent} />
			</article>
		) : (
			<div class="v2-window v2-content-window">
				<div class="v2-window-titlebar">
					<span>spec // architecture.md</span>
				</div>
				<div class="v2-empty-state">
					<p>[Technical write-up for this system is being indexed in production notes.]</p>
				</div>
			</div>
		)}
	</main>

	<!-- Retro Robot Agent & Spotlight Command Bar -->
	<CommandBarV2 email={settings?.profile_email || "ismailnuralam@gmail.com"} />

	<!-- Modals -->
	<CvModal />
	{showDemoAccess && demoAccess && (
		<DemoCredentialsModal demo={demoAccess} projectTitle={project.title} />
	)}
</LayoutV2>

<style>
	.v2-project-header {
		margin-bottom: 2.25rem;
		padding-top: 0.5rem;
	}

	.v2-project-meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.85rem;
	}

	.v2-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--v2-font-mono);
		font-size: 0.78rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease;
	}

	.v2-back-link:hover {
		color: var(--v2-green);
	}

	.v2-project-type-pill {
		font-family: var(--v2-font-mono);
		font-size: 0.72rem;
		color: var(--v2-text-dim);
	}

	.v2-project-headline {
		font-family: var(--v2-font-sans);
		font-size: clamp(2rem, 4.5vw, 2.85rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: var(--v2-text);
		margin-bottom: 0.85rem;
	}

	.v2-project-summary {
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--v2-text-muted);
		max-width: 70ch;
		margin-bottom: 1.5rem;
	}

	.v2-project-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding-top: 0.75rem;
		border-top: 1px dashed var(--v2-border);
	}

	.v2-project-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.v2-project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	/* Visual Gallery Window */
	.v2-gallery-window {
		margin-bottom: 2.5rem;
	}

	.v2-gallery-stage {
		display: flex;
		flex-direction: column;
		background: #000000;
	}

	.v2-gallery-main-frame {
		position: relative;
		width: 100%;
		max-height: 520px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: #000000;
	}

	.v2-gallery-main-img {
		width: 100%;
		height: auto;
		max-height: 520px;
		object-fit: contain;
		display: block;
	}

	.v2-gallery-scanline {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			rgba(18, 16, 16, 0) 50%,
			rgba(0, 0, 0, 0.2) 50%
		);
		background-size: 100% 2px;
		pointer-events: none;
		opacity: 0.4;
	}

	.v2-gallery-thumbs {
		display: flex;
		gap: 0.5rem;
		padding: 0.75rem;
		background: var(--v2-bg-elevated);
		border-top: 1px solid var(--v2-border);
		overflow-x: auto;
	}

	.v2-thumb-item {
		position: relative;
		width: 80px;
		height: 52px;
		flex-shrink: 0;
		border: 1px solid var(--v2-border);
		background: #000000;
		cursor: pointer;
		padding: 0;
		overflow: hidden;
		transition: border-color 0.12s ease;
	}

	.v2-thumb-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		opacity: 0.6;
		transition: opacity 0.12s ease;
	}

	.v2-thumb-item.is-active,
	.v2-thumb-item:hover {
		border-color: var(--v2-green);
	}

	.v2-thumb-item.is-active img,
	.v2-thumb-item:hover img {
		opacity: 1;
	}

	.v2-thumb-idx {
		position: absolute;
		bottom: 2px;
		right: 3px;
		font-family: var(--v2-font-mono);
		font-size: 0.62rem;
		color: #ffffff;
		background: rgba(0, 0, 0, 0.75);
		padding: 0 0.2rem;
	}

	/* Content Window */
	.v2-content-window {
		margin-bottom: 3.5rem;
	}

	.v2-markdown-body {
		padding: 2rem 2.25rem;
		font-size: 0.98rem;
		line-height: 1.75;
		color: var(--v2-text);
	}

	.v2-markdown-body :global(h2) {
		font-family: var(--v2-font-display);
		font-size: 1.45rem;
		font-weight: 700;
		color: var(--v2-text);
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		border-bottom: 1px solid var(--v2-border);
		padding-bottom: 0.4rem;
	}

	.v2-markdown-body :global(h3) {
		font-family: var(--v2-font-display);
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--v2-text);
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.v2-markdown-body :global(p) {
		margin-bottom: 1.25rem;
		color: var(--v2-text-muted);
	}

	.v2-markdown-body :global(ul),
	.v2-markdown-body :global(ol) {
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
		color: var(--v2-text-muted);
	}

	.v2-markdown-body :global(li) {
		margin-bottom: 0.35rem;
	}

	.v2-markdown-body :global(code) {
		font-family: var(--v2-font-mono);
		font-size: 0.85em;
		background: var(--v2-bg-elevated);
		border: 1px solid var(--v2-border);
		padding: 0.15rem 0.35rem;
		color: var(--v2-green);
	}

	.v2-markdown-body :global(pre) {
		background: var(--v2-bg-elevated);
		border: 1px solid var(--v2-border);
		padding: 1rem 1.25rem;
		overflow-x: auto;
		margin-bottom: 1.5rem;
	}

	.v2-markdown-body :global(pre code) {
		background: transparent;
		border: none;
		padding: 0;
		color: var(--v2-text);
	}

	.v2-empty-state {
		padding: 3rem 1.5rem;
		text-align: center;
		font-family: var(--v2-font-mono);
		font-size: 0.85rem;
		color: var(--v2-text-dim);
	}

	@media (max-width: 680px) {
		.v2-project-toolbar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
		}

		.v2-project-actions {
			width: 100%;
		}

		.v2-project-actions .v2-btn {
			flex: 1;
			justify-content: center;
		}

		.v2-markdown-body {
			padding: 1.25rem 1rem;
		}
	}
</style>

<script>
	// Gallery Thumbnail Switcher
	const mainImg = document.getElementById("v2MainPreviewImg") as HTMLImageElement | null;
	const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>(".v2-thumb-item"));

	thumbs.forEach((thumb) => {
		thumb.addEventListener("click", () => {
			const targetSrc = thumb.dataset.imgSrc;
			if (mainImg && targetSrc) {
				mainImg.src = targetSrc;
			}
			thumbs.forEach((t) => t.classList.remove("is-active"));
			thumb.classList.add("is-active");
		});
	});
</script>
