---
import LayoutV2 from "../../layouts/LayoutV2.astro";
import CommandBarV2 from "../../components/v2/CommandBarV2.astro";
import CvModal from "../../components/CvModal.astro";
import { apiFetch } from "../../utils/api";
import type { ApiProject, ApiSettings } from "../../types/index";

const t0 = Date.now();
const [projectsRes, settingsRes] = await Promise.all([
	apiFetch<ApiProject[]>("/projects"),
	apiFetch<ApiSettings>("/settings"),
]);
const fetchMs = Math.max(14, Date.now() - t0);

const projects: ApiProject[] = projectsRes ?? [];
const settings: ApiSettings = settingsRes ?? {
	available_for_work: "true",
	profile_name: "Ismail Nur Alam",
	profile_bio: "",
	profile_location: "Yogyakarta, Indonesia",
	profile_email: "ismailnuralam@gmail.com",
};

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Projects — Ismail Alam",
	url: "https://itsmail.dev/projects",
	description: "Production software, distributed backends, edge runtimes, and mobile systems engineered by Ismail Alam.",
};
---

<LayoutV2
	title="Projects — Ismail Alam"
	description="Production software, distributed backends, edge runtimes, and mobile systems engineered by Ismail Alam."
	jsonLd={jsonLd}
>
	<main class="v2-container">
		<!-- Projects Header -->
		<header class="v2-page-header">
			<div class="v2-page-header-top">
				<a href="/" class="v2-back-link">
					<span class="v2-back-arrow">←</span>
					<span>home</span>
				</a>
				<span class="v2-page-tag">[directory]</span>
			</div>
			<h1 class="v2-page-title">
				PROJECTS ARCHIVE
			</h1>
			<p class="v2-page-desc">
				Production systems, distributed backends, edge runtimes, and mobile platforms engineered for scale.
			</p>
		</header>

		<!-- Category Filter Bar (Retro Tab Frame) -->
		<div class="v2-filter-bar" role="tablist" aria-label="Project category filter">
			<button
				type="button"
				class="v2-filter-btn is-active"
				data-filter="all"
				role="tab"
				aria-selected="true"
			>
				[ALL] <span class="v2-filter-count">({projects.length})</span>
			</button>
			<button
				type="button"
				class="v2-filter-btn"
				data-filter="production"
				role="tab"
				aria-selected="false"
			>
				[PRODUCTION]
			</button>
			<button
				type="button"
				class="v2-filter-btn"
				data-filter="client_work"
				role="tab"
				aria-selected="false"
			>
				[CLIENT WORK]
			</button>
			<button
				type="button"
				class="v2-filter-btn"
				data-filter="open_source"
				role="tab"
				aria-selected="false"
			>
				[OPEN SOURCE]
			</button>
		</div>

		<!-- Window Directory Container -->
		<section class="v2-window v2-projects-window" data-v2-async-box data-fetch-ms={fetchMs} data-item-count={projects.length}>
			<div class="v2-window-titlebar">
				<span>endpoint // GET /projects</span>
				<span class="v2-box-telemetry" data-box-status>
					<span data-box-spinner>⠋</span>
					<span data-box-label>SYNCING...</span>
				</span>
			</div>

			<!-- Skeleton state -->
			<div class="v2-works-skeleton" data-box-skeleton>
				{[1, 2, 3, 4, 5, 6].map((num) => (
					<div class="v2-work-row v2-work-row-skeleton">
						<div class="v2-work-row-left">
							<span class="v2-skeleton-bar v2-thumb-skeleton"></span>
							<div class="v2-work-info">
								<span class="v2-skeleton-bar" style={`width: ${160 + (num % 3) * 40}px; height: 14px;`}></span>
								<span class="v2-skeleton-bar" style={`width: ${240 + (num % 2) * 50}px; height: 10px; margin-top: 4px;`}></span>
							</div>
						</div>
						<div class="v2-work-row-right">
							<span class="v2-skeleton-bar" style="width: 52px; height: 18px;"></span>
							<span class="v2-skeleton-bar" style="width: 58px; height: 18px;"></span>
						</div>
					</div>
				))}
			</div>

			<!-- Projects Directory Rows -->
			<div class="v2-works-directory" id="v2ProjectsList" data-box-content hidden>
				{projects.map((p) => {
					const data = p.web_profile?.data;
					const slug = data?.slug || p.id;
					const pType = data?.project_type || "side_project";
					const stack = (data?.stack ?? []).slice(0, 5);
					const thumb = data?.cover_image ?? data?.images?.[0] ?? null;

					return (
						<a
							href={`/projects/${slug}`}
							class="v2-work-row"
							data-project-item
							data-type={pType}
						>
							<div class="v2-work-row-left">
								{thumb ? (
									<div class="v2-work-thumb-frame">
										<img
											src={thumb}
											alt={p.title}
											class="v2-work-thumb-img"
											loading="lazy"
											width="80"
											height="50"
										/>
										<span class="v2-thumb-scanline" aria-hidden="true"></span>
									</div>
								) : (
									<div class="v2-work-thumb-frame v2-work-thumb-fallback">
										<span class="v2-thumb-pixel-icon">&gt;_</span>
									</div>
								)}
								<div class="v2-work-info">
									<div class="v2-work-title-wrap">
										<span class="v2-work-name">{p.title}</span>
										{p.web_profile?.is_highlighted && (
											<span class="v2-tag v2-tag-highlight">★ FLAGSHIP</span>
										)}
									</div>
									<span class="v2-work-summary">{p.description}</span>
								</div>
							</div>

							<div class="v2-work-row-right">
								<div class="v2-work-tags">
									{stack.map((tech) => (
										<span class="v2-tag">{tech}</span>
									))}
								</div>
								<span class="v2-work-arrow">→</span>
							</div>
						</a>
					);
				})}
				<div class="v2-empty-state" id="v2EmptyState" hidden>
					<span>[no projects matching this filter]</span>
				</div>
			</div>
		</section>
	</main>

	<!-- Retro Robot Agent & Spotlight Command Bar -->
	<CommandBarV2 email={settings.profile_email} />

	<!-- CV Modal -->
	<CvModal />
</LayoutV2>

<style>
	.v2-page-header {
		margin-bottom: 2rem;
		padding-top: 0.5rem;
	}

	.v2-page-header-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.v2-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--v2-font-mono);
		font-size: 0.78rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease;
	}

	.v2-back-link:hover {
		color: var(--v2-green);
	}

	.v2-page-tag {
		font-family: var(--v2-font-mono);
		font-size: 0.72rem;
		color: var(--v2-text-dim);
	}

	.v2-page-title {
		font-family: var(--v2-font-sans);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--v2-text);
		margin-bottom: 0.75rem;
	}

	.v2-title-highlight {
		color: var(--v2-green);
	}

	.v2-page-desc {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--v2-text-muted);
		max-width: 65ch;
	}

	/* Filter Bar */
	.v2-filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}

	.v2-filter-btn {
		font-family: var(--v2-font-mono);
		font-size: 0.75rem;
		padding: 0.35rem 0.65rem;
		background: var(--v2-bg-elevated);
		border: 1px solid var(--v2-border);
		color: var(--v2-text-muted);
		cursor: pointer;
		transition: border-color 0.12s ease, color 0.12s ease, background 0.12s ease;
	}

	.v2-filter-btn:hover {
		border-color: var(--v2-border-strong);
		color: var(--v2-text);
	}

	.v2-filter-btn.is-active {
		border-color: var(--v2-green);
		color: var(--v2-green);
		background: var(--v2-green-bg);
		font-weight: 700;
	}

	.v2-filter-count {
		font-size: 0.68rem;
		opacity: 0.75;
	}

	/* Projects Window */
	.v2-projects-window {
		margin-bottom: 3rem;
	}

	.v2-works-directory,
	.v2-works-skeleton {
		display: flex;
		flex-direction: column;
	}

	.v2-works-directory[hidden],
	.v2-works-skeleton[hidden] {
		display: none !important;
	}

	.v2-work-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 0.9rem 1.15rem;
		border-bottom: 1px solid var(--v2-border);
		transition: background 0.12s ease;
		text-decoration: none;
	}

	.v2-work-row:last-child {
		border-bottom: none;
	}

	.v2-work-row:hover {
		background: var(--v2-bg-elevated);
	}

	.v2-work-row:hover .v2-work-name,
	.v2-work-row:hover .v2-work-arrow {
		color: var(--v2-green);
	}

	.v2-work-row-left {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
		flex: 1;
	}

	.v2-work-idx {
		font-size: 0.72rem;
		color: var(--v2-text-dim);
		font-weight: 600;
		flex-shrink: 0;
	}

	.v2-work-thumb-frame {
		position: relative;
		width: 76px;
		height: 48px;
		flex-shrink: 0;
		border: 1px solid var(--v2-border-strong);
		background: var(--v2-bg);
		overflow: hidden;
	}

	.v2-work-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: grayscale(85%) contrast(110%);
		transition: filter 0.15s ease, transform 0.15s ease;
	}

	.v2-work-row:hover .v2-work-thumb-img {
		filter: grayscale(0%) contrast(100%);
		transform: scale(1.05);
	}

	.v2-thumb-scanline {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			rgba(18, 16, 16, 0) 50%,
			rgba(0, 0, 0, 0.25) 50%
		);
		background-size: 100% 2px;
		pointer-events: none;
		opacity: 0.6;
	}

	.v2-work-thumb-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--v2-bg-elevated);
	}

	.v2-thumb-pixel-icon {
		font-family: var(--v2-font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--v2-text-dim);
	}

	.v2-thumb-skeleton {
		width: 76px;
		height: 48px;
		flex-shrink: 0;
	}

	.v2-work-info {
		display: flex;
		flex-direction: column;
		gap: 0.18rem;
		min-width: 0;
	}

	.v2-work-title-wrap {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.v2-work-name {
		font-family: var(--v2-font-display);
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--v2-text);
		transition: color 0.12s ease;
	}

	.v2-tag-highlight {
		color: var(--v2-green);
		border-color: var(--v2-green);
		font-size: 0.62rem;
		padding: 0.05rem 0.35rem;
	}

	.v2-work-summary {
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--v2-text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 58ch;
	}

	.v2-work-row-right {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
	}

	.v2-work-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	.v2-work-arrow {
		font-size: 0.85rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease, transform 0.12s ease;
	}

	.v2-work-row:hover .v2-work-arrow {
		transform: translateX(2px);
	}

	.v2-empty-state {
		padding: 3rem 1.5rem;
		text-align: center;
		font-family: var(--v2-font-mono);
		font-size: 0.82rem;
		color: var(--v2-text-dim);
	}

	@media (max-width: 680px) {
		.v2-work-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.65rem;
		}

		.v2-work-row-left {
			width: 100%;
			align-items: center;
			gap: 0.65rem;
		}

		.v2-work-thumb-frame,
		.v2-thumb-skeleton {
			width: 60px;
			height: 38px;
		}

		.v2-work-summary {
			white-space: normal;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
		}

		.v2-work-row-right {
			width: 100%;
			justify-content: space-between;
			padding-left: calc(0.72rem + 60px + 0.65rem);
		}
	}
</style>

<script>
	// Tab Category Filter
	const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".v2-filter-btn"));
	const projectRows = Array.from(document.querySelectorAll<HTMLElement>("[data-project-item]"));
	const emptyState = document.getElementById("v2EmptyState");

	filterBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			filterBtns.forEach((b) => {
				b.classList.remove("is-active");
				b.setAttribute("aria-selected", "false");
			});
			btn.classList.add("is-active");
			btn.setAttribute("aria-selected", "true");

			const filter = btn.dataset.filter || "all";
			let visibleCount = 0;

			projectRows.forEach((row) => {
				const rowType = row.dataset.type;
				const matches = filter === "all" || rowType === filter;
				row.style.display = matches ? "flex" : "none";
				if (matches) visibleCount++;
			});

			if (emptyState) {
				emptyState.hidden = visibleCount > 0;
			}
		});
	});
</script>
