---
import LayoutV2 from "../../layouts/LayoutV2.astro";
import CommandBarV2 from "../../components/v2/CommandBarV2.astro";
import CvModal from "../../components/CvModal.astro";
---

<LayoutV2
	title="Certificates & Credentials — Ismail Alam"
	description="Professional certifications, training credentials, and engineering specializations by Ismail Alam."
	canonicalURL="https://itsmail.dev/certificates"
>
	<main class="v2-container">
		<!-- Page Header -->
		<header class="v2-page-header">
			<div class="v2-page-header-top">
				<a href="/" class="v2-back-link">
					<span class="v2-back-arrow">←</span>
					<span>home</span>
				</a>
				<span class="v2-page-tag">[verified credentials]</span>
			</div>
			<h1 class="v2-page-title">
				CERTIFICATES &amp; TRAINING
			</h1>
			<p class="v2-page-desc">
				Verified professional specializations, cloud architecture certifications, and systems training records.
			</p>
		</header>

		<!-- Window Container -->
		<section class="v2-window v2-certs-window" id="v2CertsWindow">
			<div class="v2-window-titlebar">
				<span>endpoint // GET /certificates</span>
				<span class="v2-box-telemetry" id="v2CertsTelemetry">
					<span id="v2CertsSpinner">⠋</span>
					<span id="v2CertsStatusLabel">SYNCING CREDENTIALS...</span>
				</span>
			</div>

			<!-- Skeleton State -->
			<div class="v2-certs-skeleton" id="v2CertsSkeleton">
				{[1, 2, 3, 4, 5, 6].map((num) => (
					<div class="v2-cert-row v2-cert-skeleton">
						<span class="v2-skeleton-bar" style="width: 70px; height: 12px;"></span>
						<span class="v2-skeleton-bar" style={`width: ${180 + (num % 3) * 60}px; height: 14px;`}></span>
						<span class="v2-skeleton-bar" style="width: 90px; height: 12px; margin-left: auto;"></span>
					</div>
				))}
			</div>

			<!-- Live Directory List -->
			<div class="v2-certs-list" id="v2CertsList" hidden></div>

			<!-- Empty / Error state -->
			<div class="v2-empty-state" id="v2CertsNotice" hidden>
				<span id="v2CertsNoticeText">[fetching certificates...]</span>
			</div>
		</section>
	</main>

	<!-- Retro Preview Modal -->
	<dialog id="v2CertModal" class="v2-cert-dialog" aria-modal="true" aria-labelledby="v2CertModalTitle">
		<div class="v2-window">
			<div class="v2-window-titlebar v2-window-titlebar-invert">
				<span id="v2CertModalTitle">credential // preview</span>
				<button type="button" class="v2-modal-close" id="v2CloseCertModalBtn">[esc]</button>
			</div>
			<div class="v2-cert-modal-body" id="v2CertModalBody"></div>
		</div>
	</dialog>

	<!-- Retro Robot Agent & Spotlight Command Bar -->
	<CommandBarV2 email="ismailnuralam@gmail.com" />

	<!-- CV Modal -->
	<CvModal />
</LayoutV2>

<style is:global>
	.v2-page-header {
		margin-bottom: 2rem;
		padding-top: 0.5rem;
	}

	.v2-page-header-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.v2-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--v2-font-mono);
		font-size: 0.78rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease;
	}

	.v2-back-link:hover {
		color: var(--v2-green);
	}

	.v2-page-tag {
		font-family: var(--v2-font-mono);
		font-size: 0.72rem;
		color: var(--v2-text-dim);
	}

	.v2-page-title {
		font-family: var(--v2-font-sans);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--v2-text);
		margin-bottom: 0.75rem;
	}

	.v2-title-highlight {
		color: var(--v2-green);
	}

	.v2-page-desc {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--v2-text-muted);
		max-width: 65ch;
	}

	/* Certs Window */
	.v2-certs-window {
		margin-bottom: 3.5rem;
	}

	.v2-certs-list,
	.v2-certs-skeleton {
		display: flex;
		flex-direction: column;
	}

	.v2-certs-list[hidden],
	.v2-certs-skeleton[hidden] {
		display: none !important;
	}

	.v2-cert-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 0.9rem 1.15rem;
		border-bottom: 1px solid var(--v2-border);
		cursor: pointer;
		transition: background 0.12s ease;
		background: var(--v2-bg);
		width: 100%;
		border-left: none;
		border-right: none;
		border-top: none;
		text-align: left;
		color: var(--v2-text);
		font-family: var(--v2-font-sans);
	}

	.v2-cert-row:last-child {
		border-bottom: none;
	}

	.v2-cert-row:hover {
		background: var(--v2-bg-elevated);
	}

	.v2-cert-row:hover .v2-cert-title,
	.v2-cert-row:hover .v2-cert-arrow {
		color: var(--v2-green);
	}

	.v2-cert-left {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
		flex: 1;
	}

	.v2-cert-badge {
		font-family: var(--v2-font-mono);
		font-size: 0.68rem;
		color: var(--v2-green);
		background: var(--v2-green-bg);
		border: 1px solid var(--v2-green);
		padding: 0.1rem 0.4rem;
		flex-shrink: 0;
	}

	.v2-cert-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.v2-cert-title {
		font-family: var(--v2-font-display);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--v2-text);
		transition: color 0.12s ease;
	}

	.v2-cert-issuer {
		font-size: 0.76rem;
		color: var(--v2-text-muted);
	}

	.v2-cert-right {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
	}

	.v2-cert-date {
		font-family: var(--v2-font-mono);
		font-size: 0.74rem;
		color: var(--v2-text-dim);
	}

	.v2-cert-arrow {
		font-size: 0.85rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease, transform 0.12s ease;
	}

	.v2-cert-row:hover .v2-cert-arrow {
		transform: translateX(2px);
	}

	.v2-empty-state {
		padding: 3rem 1.5rem;
		text-align: center;
		font-family: var(--v2-font-mono);
		font-size: 0.82rem;
		color: var(--v2-text-dim);
	}

	/* Modal Dialog */
	.v2-cert-dialog {
		margin: auto;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--v2-text);
		width: min(640px, 94vw);
	}

	.v2-cert-dialog::backdrop {
		background: rgba(9, 10, 15, 0.75);
		backdrop-filter: blur(2px);
	}

	.v2-cert-modal-body {
		padding: 1.5rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.v2-cert-modal-preview {
		max-height: 380px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #000000;
		border: 1px solid var(--v2-border);
		overflow: hidden;
	}

	.v2-cert-modal-preview img {
		max-width: 100%;
		max-height: 380px;
		object-fit: contain;
	}

	.v2-cert-modal-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-top: 0.5rem;
		border-top: 1px dashed var(--v2-border);
	}

	@media (max-width: 680px) {
		.v2-cert-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
		}
		.v2-cert-right {
			width: 100%;
			justify-content: space-between;
			padding-left: 2.2rem;
		}
	}
</style>

<script>
	const API_BASE = "https://my-data.itsmail.dev/api";

	interface CertItem {
		id: string;
		title: string;
		issuer?: string;
		issued_at?: string;
		credential_id?: string | null;
		credential_url?: string | null;
		category?: string | null;
		file_url?: string | null;
		file_type?: "pdf" | "image" | null;
	}

	const listEl = document.getElementById("v2CertsList");
	const skeletonEl = document.getElementById("v2CertsSkeleton");
	const noticeEl = document.getElementById("v2CertsNotice");
	const noticeText = document.getElementById("v2CertsNoticeText");
	const spinnerEl = document.getElementById("v2CertsSpinner");
	const statusLabel = document.getElementById("v2CertsStatusLabel");

	const modal = document.getElementById("v2CertModal") as HTMLDialogElement | null;
	const modalClose = document.getElementById("v2CloseCertModalBtn");
	const modalTitle = document.getElementById("v2CertModalTitle");
	const modalBody = document.getElementById("v2CertModalBody");

	modalClose?.addEventListener("click", () => modal?.close());
	modal?.addEventListener("click", (e) => {
		const r = modal.getBoundingClientRect();
		if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
			modal.close();
		}
	});

	function formatDate(iso?: string) {
		if (!iso) return "";
		try {
			return new Date(iso).toLocaleDateString("en-US", {
				year: "numeric",
				month: "short",
			});
		} catch {
			return iso;
		}
	}

	/** Escape API-provided text before it enters an innerHTML template. */
	function esc(value: unknown): string {
		return String(value ?? "")
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#39;");
	}

	/** Only allow http(s) URLs; anything else (javascript:, data:) becomes inert. */
	function safeUrl(value?: string | null): string {
		if (!value) return "";
		try {
			const parsed = new URL(value, window.location.origin);
			return parsed.protocol === "https:" || parsed.protocol === "http:" ? parsed.href : "";
		} catch {
			return "";
		}
	}

	async function loadCerts() {
		const t0 = performance.now();
		try {
			const res = await fetch(`${API_BASE}/certificates`);
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const data = (await res.json()) as CertItem[] | { data?: CertItem[] };
			const certs: CertItem[] = Array.isArray(data) ? data : data?.data ?? [];
			const elapsed = Math.round(performance.now() - t0);

			if (spinnerEl && statusLabel) {
				spinnerEl.textContent = "●";
				spinnerEl.style.color = "var(--v2-green)";
				statusLabel.textContent = `200 OK · ${certs.length} verified (${elapsed}ms)`;
			}

			if (skeletonEl) skeletonEl.hidden = true;

			if (!certs.length) {
				if (noticeEl && noticeText) {
					noticeEl.hidden = false;
					noticeText.textContent = "[no certificates indexed in public ledger]";
				}
				return;
			}

			if (listEl) {
				listEl.innerHTML = "";
				certs.forEach((cert) => {
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "v2-cert-row";

					const category = esc((cert.category || "CERT").toUpperCase());
					const dateStr = esc(formatDate(cert.issued_at));

					btn.innerHTML = `
						<div class="v2-cert-left" style="display:flex; align-items:center; gap:1rem; min-width:0; flex:1;">
							<span class="v2-cert-badge" style="font-family:var(--v2-font-mono); font-size:0.68rem; color:var(--v2-green); background:var(--v2-green-bg); border:1px solid var(--v2-green); padding:0.1rem 0.4rem; flex-shrink:0;">[${category}]</span>
							<div class="v2-cert-info" style="display:flex; flex-direction:column; gap:0.15rem; min-width:0;">
								<span class="v2-cert-title" style="font-family:var(--v2-font-display); font-size:0.95rem; font-weight:600; color:var(--v2-text);">${esc(cert.title)}</span>
								<span class="v2-cert-issuer" style="font-size:0.76rem; color:var(--v2-text-muted);">${esc(cert.issuer || "Verified Issuer")}</span>
							</div>
						</div>
						<div class="v2-cert-right" style="display:flex; align-items:center; gap:0.85rem; flex-shrink:0;">
							<span class="v2-cert-date" style="font-family:var(--v2-font-mono); font-size:0.74rem; color:var(--v2-text-dim);">${dateStr}</span>
							<span class="v2-cert-arrow" style="font-size:0.85rem; color:var(--v2-text-muted);">↗</span>
						</div>
					`;

					btn.addEventListener("click", () => openCertDetail(cert));
					listEl.appendChild(btn);
				});

				listEl.hidden = false;
			}
		} catch (err) {
			if (skeletonEl) skeletonEl.hidden = true;
			if (noticeEl && noticeText) {
				noticeEl.hidden = false;
				noticeText.textContent = "[failed to fetch certificates from API]";
			}
		}
	}

	function openCertDetail(cert: CertItem) {
		if (!modal || !modalBody || !modalTitle) return;
		modalTitle.textContent = `credential // ${cert.id}`;

		const fileUrl = safeUrl(cert.file_url);
		const credentialUrl = safeUrl(cert.credential_url);

		const imgBlock = fileUrl && cert.file_type !== "pdf"
			? `<div class="v2-cert-modal-preview"><img src="${esc(fileUrl)}" alt="${esc(cert.title)}" /></div>`
			: "";

		const credIdBlock = cert.credential_id
			? `<p style="font-family: var(--v2-font-mono); font-size: 0.76rem; color: var(--v2-text-muted);">
					Credential ID: <span style="color: var(--v2-green);">${esc(cert.credential_id)}</span>
			   </p>`
			: "";

		const actions = [
			credentialUrl
				? `<a href="${esc(credentialUrl)}" target="_blank" rel="noopener noreferrer" class="v2-btn v2-btn-primary">[Verify Credential ↗]</a>`
				: "",
			fileUrl
				? `<a href="${esc(fileUrl)}" target="_blank" rel="noopener noreferrer" class="v2-btn">[View Original File ↗]</a>`
				: "",
		].filter(Boolean).join(" ");

		modalBody.innerHTML = `
			<div>
				<h3 style="font-family: var(--v2-font-display); font-size: 1.25rem; font-weight: 700; color: var(--v2-text); margin-bottom: 0.35rem;">${esc(cert.title)}</h3>
				<p style="font-size: 0.85rem; color: var(--v2-text-muted);">${esc(cert.issuer || "")} · ${esc(formatDate(cert.issued_at))}</p>
			</div>
			${credIdBlock}
			${imgBlock}
			${actions ? `<div class="v2-cert-modal-actions">${actions}</div>` : ""}
		`;

		modal.showModal();
	}

	loadCerts();
</script>
