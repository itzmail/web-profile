---
import LayoutV2 from "../layouts/LayoutV2.astro";
import CommandBarV2 from "../components/v2/CommandBarV2.astro";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "404 Not Found — Ismail Alam",
	description: "The requested route does not exist or has been relocated.",
};
---

<LayoutV2
	title="404: Inode Not Found — Ismail Alam"
	description="The requested route does not exist or has been relocated."
	jsonLd={jsonLd}
>
	<main class="v2-container">
		<div class="v2-window v2-404-window">
			<div class="v2-window-titlebar v2-window-titlebar-invert">
				<span>kernel panic // 404_PAGE_NOT_FOUND</span>
				<span class="v2-404-badge">[ERR_INODE_MISSING]</span>
			</div>

			<div class="v2-404-body">
				<div class="v2-404-glitch-row">
					<span class="v2-404-num">404</span>
					<div class="v2-404-meta">
						<span class="v2-404-title">ROUTE TERMINATED</span>
						<span class="v2-404-desc">The requested memory address or route does not exist in cluster index.</span>
					</div>
				</div>

				<div class="v2-404-terminal">
					<div class="v2-term-line">
						<span class="v2-term-prompt">&gt;</span>
						<span class="v2-term-cmd">resolve path: <span id="v2ReqPath">...</span></span>
					</div>
					<div class="v2-term-line v2-term-err">
						<span>[!] status: 404 Not Found</span>
					</div>
					<div class="v2-term-line v2-term-hint">
						<span># recommended: return to root or summon AI agent via ⌘K</span>
					</div>
				</div>

				<div class="v2-404-actions">
					<a href="/" class="v2-btn v2-btn-primary">
						[← Return to Home]
					</a>
					<a href="/projects" class="v2-btn">
						[Browse Projects →]
					</a>
					<button type="button" class="v2-btn" id="v2OpenAgentFrom404">
						[Summon Agent ⌘K]
					</button>
				</div>
			</div>
		</div>
	</main>

	<!-- Retro Robot Agent & Spotlight Command Bar -->
	<CommandBarV2 email="ismailnuralam@gmail.com" />
</LayoutV2>

<style>
	.v2-404-window {
		max-width: 620px;
		margin: 4rem auto;
		box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.7);
	}

	.v2-404-badge {
		font-family: var(--v2-font-mono);
		font-size: 0.68rem;
		color: #ff5555;
	}

	.v2-404-body {
		padding: 2.25rem 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.v2-404-glitch-row {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		border-bottom: 1px dashed var(--v2-border);
		padding-bottom: 1.5rem;
	}

	.v2-404-num {
		font-family: var(--v2-font-sans);
		font-size: clamp(3.5rem, 8vw, 4.75rem);
		font-weight: 800;
		color: #ff5555;
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.v2-404-meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.v2-404-title {
		font-family: var(--v2-font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--v2-text);
	}

	.v2-404-desc {
		font-size: 0.85rem;
		color: var(--v2-text-muted);
		line-height: 1.45;
	}

	.v2-404-terminal {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1rem 1.25rem;
		background: var(--v2-bg-elevated);
		border: 1px solid var(--v2-border);
		font-family: var(--v2-font-mono);
		font-size: 0.78rem;
	}

	.v2-term-line {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.v2-term-prompt {
		color: var(--v2-green);
		font-weight: 700;
	}

	.v2-term-err {
		color: #ff5555;
	}

	.v2-term-hint {
		color: var(--v2-text-dim);
	}

	.v2-404-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	@media (max-width: 640px) {
		.v2-404-body {
			padding: 1.5rem 1.25rem;
		}
		.v2-404-glitch-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
		.v2-404-actions .v2-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<script>
	const pEl = document.getElementById("v2ReqPath");
	if (pEl) pEl.textContent = window.location.pathname;

	const agentBtn = document.getElementById("v2OpenAgentFrom404");
	agentBtn?.addEventListener("click", () => {
		const w = window as unknown as Record<string, (() => void) | undefined>;
		w.__v2OpenAgent?.();
	});
</script>
