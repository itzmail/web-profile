---
import Layout from "../../layouts/Layout.astro";
import JsonTool from "../../components/tools/JsonTool.astro";
import Base64Tool from "../../components/tools/Base64Tool.astro";
import TimestampTool from "../../components/tools/TimestampTool.astro";
import UuidTool from "../../components/tools/UuidTool.astro";
import CurlTool from "../../components/tools/CurlTool.astro";
import CronTool from "../../components/tools/CronTool.astro";
import CidrTool from "../../components/tools/CidrTool.astro";
import HashTool from "../../components/tools/HashTool.astro";
import DiffTool from "../../components/tools/DiffTool.astro";
import RegexTool from "../../components/tools/RegexTool.astro";

const TOOLS = [
	{ id: "json", label: "JSON Swiss Knife", desc: "Beautify · Minify · Validate · → TypeScript", icon: "{ }" },
	{ id: "base64", label: "Base64 & URL", desc: "UTF-8 safe encode/decode · image preview", icon: "b64" },
	{ id: "timestamp", label: "Epoch Converter", desc: "Live clock · s/ms/µs · relative time", icon: "⏱" },
	{ id: "uuid", label: "UUID & ULID", desc: "v4 · v7 · ULID generator + inspector", icon: "#ID" },
	{ id: "curl", label: "Curl to Code", desc: "cURL → fetch · axios · Python · Go · PHP", icon: "→req" },
	{ id: "cron", label: "Cron Visualizer", desc: "Human description · next 5 executions", icon: "⏰" },
	{ id: "cidr", label: "Subnet / CIDR", desc: "IPv4 range · mask · binary · RFC scope", icon: "/24" },
	{ id: "hash", label: "Hash & HMAC", desc: "MD5 · SHA-1/256/512 · HMAC · Hex/Base64", icon: "#hx" },
	{ id: "diff", label: "Diff Checker", desc: "Side-by-side & unified · JSON normalize", icon: "±" },
	{ id: "regex", label: "Regex Tester", desc: "Live match highlight · token explainer", icon: ".*" },
] as const;

type ToolId = (typeof TOOLS)[number]["id"];
const DEFAULT_TOOL: ToolId = "json";

// Deep-link support: /tools?tab=timestamp
const requested = Astro.url.searchParams.get("tab");
const activeTool: ToolId = (TOOLS.find((t) => t.id === requested)?.id ?? DEFAULT_TOOL) as ToolId;

// Rich-snippet structured data for the tools hub
const toolsJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: "Developer Tools — itsmail.dev",
	alternateName: "itsmail.dev DevTools",
	url: "https://itsmail.dev/tools",
	applicationCategory: "DeveloperApplication",
	operatingSystem: "Any (Web Browser)",
	description:
		"Free online developer tools that run 100% client-side: JSON formatter & TypeScript generator, Base64/URL encoder-decoder, Unix epoch timestamp converter, UUID/ULID generator, cURL to code converter, cron expression visualizer, IPv4 subnet calculator, hash & HMAC generator, text diff checker, and regex tester. No data leaves your browser.",
	featureList: TOOLS.map((t) => t.label),
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	author: {
		"@type": "Person",
		name: "Ismail Alam",
		url: "https://itsmail.dev",
	},
};
---

<Layout
	title="Free Developer Tools — JSON, Base64, Cron, CIDR & Regex | Ismail Alam"
	description="Free client-side developer tools: JSON formatter & TypeScript generator, Base64/URL converter, epoch timestamp converter, UUID/ULID generator, cURL to code, cron visualizer, CIDR subnet calculator, hash & HMAC, diff checker, and regex tester. 100% in your browser — zero tracking."
	canonicalURL="https://itsmail.dev/tools"
	jsonLd={toolsJsonLd}
>
	<main class="tools-page">
		<div class="container">
			<header class="page-header reveal">
				<p class="font-mono page-eyebrow">// devtools</p>
				<h1 class="page-title">Developer Tools</h1>
				<p class="page-sub text-muted">
					All-in-one utilities for everyday engineering. Everything runs <strong>100% in your browser</strong> —
					no data ever leaves your machine.
				</p>
				<p class="tools-seo-list font-mono">
					{TOOLS.map((t, i) => (
						<>
							{i > 0 && " · "}
							<span>{t.label}</span>
						</>
					))}
				</p>
			</header>

			<div class="tools-layout">
				<!-- Sidebar -->
				<aside class="tools-sidebar reveal">
					<nav class="tools-nav" id="toolsNav" aria-label="Developer tools">
						{TOOLS.map((tool) => (
							<button
								class={`tools-nav-item font-mono ${tool.id === activeTool ? "active" : ""}`}
								data-tool={tool.id}
							>
								<span class="tools-nav-icon">{tool.icon}</span>
								<span class="tools-nav-text">
									<span class="tools-nav-label">{tool.label}</span>
									<span class="tools-nav-desc">{tool.desc}</span>
								</span>
							</button>
						))}
					</nav>
					<div class="tools-privacy font-mono">
						<span class="privacy-dot"></span> 100% client-side · zero tracking
					</div>
				</aside>

				<!-- Workspace -->
				<section class="tools-workspace reveal">
					{TOOLS.map((tool) => (
						<div
							class={`tool-panel ${tool.id === activeTool ? "" : "hidden"}`}
							id={`tool-${tool.id}`}
						>
							<h2 class="tool-panel-title font-mono">{tool.label}</h2>
							{tool.id === "json" && <JsonTool />}
							{tool.id === "base64" && <Base64Tool />}
							{tool.id === "timestamp" && <TimestampTool />}
							{tool.id === "uuid" && <UuidTool />}
							{tool.id === "curl" && <CurlTool />}
							{tool.id === "cron" && <CronTool />}
							{tool.id === "cidr" && <CidrTool />}
							{tool.id === "hash" && <HashTool />}
							{tool.id === "diff" && <DiffTool />}
							{tool.id === "regex" && <RegexTool />}
						</div>
					))}
				</section>
			</div>
		</div>
	</main>
</Layout>

<script>
	const navItems = [...document.querySelectorAll<HTMLButtonElement>(".tools-nav-item")];
	const panels = [...document.querySelectorAll<HTMLElement>(".tool-panel")];

	function activate(toolId: string, pushUrl: boolean) {
		navItems.forEach((b) => b.classList.toggle("active", b.dataset.tool === toolId));
		panels.forEach((p) => {
			const isActive = p.id === `tool-${toolId}`;
			p.classList.toggle("hidden", !isActive);
			p.dataset.active = String(isActive);
		});
		if (pushUrl) {
			const url = new URL(window.location.href);
			url.searchParams.set("tab", toolId);
			history.replaceState(null, "", url.toString());
		}
	}

	navItems.forEach((btn) => {
		btn.addEventListener("click", () => activate(btn.dataset.tool!, true));
	});
</script>

<style>
	.tools-page {
		padding-top: calc(var(--nav-h) + 3rem);
		padding-bottom: 6rem;
		min-height: 100vh;
	}

	.page-header {
		margin-bottom: 2.5rem;
	}

	.page-eyebrow {
		font-size: 0.875rem;
		color: var(--cyan);
		margin-bottom: 0.5rem;
	}

	.page-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		color: var(--text);
		letter-spacing: -0.02em;
		margin-bottom: 0.75rem;
	}

	.page-sub {
		font-size: 1.0625rem;
		max-width: 680px;
		line-height: 1.6;
	}

	.tools-seo-list {
		margin-top: 0.75rem;
		font-size: 0.71875rem;
		color: #94a3b8;
		letter-spacing: 0.02em;
	}

	.tools-seo-list span {
		color: var(--text-muted);
	}

	.tools-layout {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 1.5rem;
		align-items: start;
	}

	@media (max-width: 900px) {
		.tools-layout {
			grid-template-columns: 1fr;
		}
	}

	/* ── Sidebar ── */
	.tools-nav {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.tools-nav-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-align: left;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 0.75rem 1rem;
		cursor: pointer;
		transition: all var(--duration) var(--ease);
		color: var(--text-muted);
	}

	.tools-nav-item:hover {
		border-color: var(--border-glow);
		color: var(--text);
	}

	.tools-nav-item.active {
		border-color: rgba(0, 255, 136, 0.35);
		background: rgba(0, 255, 136, 0.05);
		color: var(--text);
	}

	.tools-nav-icon {
		font-size: 0.8125rem;
		color: var(--green);
		min-width: 2.2rem;
		text-align: center;
	}

	.tools-nav-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.tools-nav-label {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text);
	}

	.tools-nav-desc {
		font-size: 0.6875rem;
		color: #94a3b8;
	}

	.tools-privacy {
		margin-top: 1rem;
		font-size: 0.6875rem;
		color: #94a3b8;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.privacy-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--green);
		box-shadow: 0 0 8px var(--green-glow);
	}

	/* ── Workspace ── */
	.tool-panel {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.5rem;
	}

	.tool-panel.hidden {
		display: none;
	}

	.tool-panel-title {
		font-size: 0.8125rem;
		color: var(--cyan);
		margin-bottom: 1.25rem;
		letter-spacing: 0.05em;
	}

	@media (max-width: 640px) {
		.tool-panel {
			padding: 1rem;
		}
	}
</style>

<style is:global>
	/* Shared styles used by all tool components (cross-file) */
	.pane-label {
		font-size: 0.75rem;
		color: var(--cyan);
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.5rem;
	}

	.pane-meta {
		color: var(--text-dim);
	}

	.ts-section {
		margin-bottom: 1.25rem;
	}

	.ts-input-row {
		display: flex;
		gap: 0.5rem;
		margin: 0.5rem 0;
		flex-wrap: wrap;
	}

	.ts-input-row .tool-input {
		flex: 1;
		min-width: 200px;
	}

	.ts-result-grid {
		display: grid;
		gap: 0.4rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 0.75rem 1rem;
		background: var(--surface);
	}

	.ts-result-item {
		display: flex;
		gap: 1rem;
		align-items: baseline;
		flex-wrap: wrap;
	}

	.ts-result-key {
		color: var(--cyan);
		font-size: 0.75rem;
		min-width: 130px;
	}

	.ts-result-val {
		color: var(--text);
		font-size: 0.8125rem;
		word-break: break-all;
	}

	.tool-toolbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
	}

	.toolbar-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tool-btn {
		background: var(--badge-bg);
		border: 1px solid var(--badge-border);
		color: var(--badge-text);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.45rem 0.85rem;
		border-radius: 6px;
		cursor: pointer;
		transition: all var(--duration) var(--ease);
		white-space: nowrap;
	}

	.tool-btn:hover {
		color: var(--green);
		border-color: var(--border-glow);
		background: var(--green-glow);
	}

	.tool-btn-danger:hover {
		color: var(--red);
		border-color: rgba(255, 77, 109, 0.4);
		background: rgba(255, 77, 109, 0.08);
	}

	.tool-select,
	.tool-input {
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		padding: 0.45rem 0.75rem;
		border-radius: 6px;
		outline: none;
		transition: border-color var(--duration) var(--ease);
	}

	.tool-input-sm {
		width: 72px;
	}

	.tool-input:focus,
	.tool-select:focus {
		border-color: var(--border-glow);
	}

	.tool-textarea {
		width: 100%;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.55;
		padding: 0.85rem 1rem;
		border-radius: 8px;
		resize: vertical;
		outline: none;
		transition: border-color var(--duration) var(--ease);
	}

	.tool-textarea:focus {
		border-color: var(--border-glow);
	}

	.tool-check {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.6875rem;
		color: var(--text-muted);
		cursor: pointer;
		user-select: none;
	}

	.tool-check input {
		accent-color: var(--green);
	}

	.json-status,
	.b64-status {
		margin-top: 0.85rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		border-top: 1px solid var(--border);
		padding-top: 0.75rem;
	}

	.json-status[data-state="ok"],
	.b64-status[data-state="ok"] {
		color: var(--green);
	}

	.json-status[data-state="error"],
	.b64-status[data-state="error"] {
		color: var(--red);
	}
</style>
