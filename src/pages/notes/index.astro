---
import LayoutV2 from "../../layouts/LayoutV2.astro";
import CommandBarV2 from "../../components/v2/CommandBarV2.astro";
import CvModal from "../../components/CvModal.astro";
import { apiFetch } from "../../utils/api";
import type { PostListItem, PaginatedResponse, ApiSettings } from "../../types/index";

const t0 = Date.now();
const [rawPosts, settingsRes] = await Promise.all([
	apiFetch<PaginatedResponse<PostListItem> | PostListItem[]>("/posts"),
	apiFetch<ApiSettings>("/settings"),
]);
const fetchMs = Math.max(14, Date.now() - t0);

const posts: PostListItem[] = Array.isArray(rawPosts)
	? rawPosts
	: rawPosts?.data ?? [];

const settings: ApiSettings = settingsRes ?? {
	available_for_work: "true",
	profile_name: "Ismail Nur Alam",
	profile_bio: "",
	profile_location: "Yogyakarta, Indonesia",
	profile_email: "ismailnuralam@gmail.com",
};

function formatIsoDate(iso: string) {
	try {
		const d = new Date(iso);
		if (isNaN(d.getTime())) return "2025-01-01";
		return d.toISOString().split("T")[0];
	} catch {
		return "2025-01-01";
	}
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Blog",
	name: "Technical Notes — Ismail Alam",
	url: "https://itsmail.dev/notes",
	description: "Engineering notes, RFCs, distributed systems post-mortems, and architecture write-ups by Ismail Alam.",
};
---

<LayoutV2
	title="Notes — Ismail Alam"
	description="Engineering notes, RFCs, distributed systems post-mortems, and architecture write-ups by Ismail Alam."
	jsonLd={jsonLd}
>
	<main class="v2-container">
		<!-- Notes Header -->
		<header class="v2-page-header">
			<div class="v2-page-header-top">
				<a href="/" class="v2-back-link">
					<span class="v2-back-arrow">←</span>
					<span>home</span>
				</a>
				<span class="v2-page-tag">[engineering logbook]</span>
			</div>
			<h1 class="v2-page-title">
				TECHNICAL NOTES
			</h1>
			<p class="v2-page-desc">
				RFCs, systems architecture write-ups, failure post-mortems, and edge runtime experiments.
			</p>
		</header>

		<!-- Monospace Grep Filter Bar -->
		<div class="v2-grep-bar">
			<span class="v2-grep-prompt">&gt; grep notes:</span>
			<input
				type="text"
				id="v2NotesGrepInput"
				class="v2-grep-input"
				placeholder="type keyword to filter write-ups..."
				autocomplete="off"
				spellcheck="false"
			/>
			<span class="v2-grep-counter" id="v2NotesCounter">[{posts.length} entries]</span>
		</div>

		<!-- Window Directory Container -->
		<section class="v2-window v2-notes-window" data-v2-async-box data-fetch-ms={fetchMs} data-item-count={posts.length}>
			<div class="v2-window-titlebar">
				<span>endpoint // GET /notes</span>
				<span class="v2-box-telemetry" data-box-status>
					<span data-box-spinner>⠋</span>
					<span data-box-label>SYNCING...</span>
				</span>
			</div>

			<!-- Skeleton state -->
			<div class="v2-notes-skeleton" data-box-skeleton>
				{[1, 2, 3, 4, 5].map((num) => (
					<div class="v2-note-row v2-note-row-skeleton">
						<span class="v2-skeleton-bar" style="width: 85px; height: 12px;"></span>
						<span class="v2-skeleton-bar" style={`width: ${220 + (num % 3) * 50}px; height: 14px;`}></span>
						<span class="v2-skeleton-bar" style="width: 60px; height: 12px; margin-left: auto;"></span>
					</div>
				))}
			</div>

			<!-- Notes Rows -->
			<div class="v2-notes-directory" id="v2NotesList" data-box-content hidden>
				{posts.map((post) => {
					const dateStr = formatIsoDate(post.published_at);
					const href = `/notes/${post.slug || post.short_code}`;
					const readTime = post.reading_time ? `${post.reading_time}m read` : "note";

					return (
						<a
							href={href}
							class="v2-note-row"
							data-note-item
							data-title={(post.title ?? "").toLowerCase()}
							data-excerpt={(post.excerpt ?? "").toLowerCase()}
						>
							<time class="v2-note-date" datetime={post.published_at}>
								{dateStr}
							</time>
							<div class="v2-note-info">
								<span class="v2-note-title">{post.title}</span>
								{post.excerpt && (
									<span class="v2-note-excerpt">{post.excerpt}</span>
								)}
							</div>
							<div class="v2-note-meta">
								<span class="v2-note-read">{readTime}</span>
								<span class="v2-note-arrow">→</span>
							</div>
						</a>
					);
				})}

				<div class="v2-empty-state" id="v2NotesEmpty" hidden>
					<span>[grep: no matching notes found]</span>
				</div>
			</div>
		</section>
	</main>

	<!-- Retro Robot Agent & Spotlight Command Bar -->
	<CommandBarV2 email={settings?.profile_email || "ismailnuralam@gmail.com"} />

	<!-- CV Modal -->
	<CvModal />
</LayoutV2>

<style>
	.v2-page-header {
		margin-bottom: 2rem;
		padding-top: 0.5rem;
	}

	.v2-page-header-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.v2-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--v2-font-mono);
		font-size: 0.78rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease;
	}

	.v2-back-link:hover {
		color: var(--v2-green);
	}

	.v2-page-tag {
		font-family: var(--v2-font-mono);
		font-size: 0.72rem;
		color: var(--v2-text-dim);
	}

	.v2-page-title {
		font-family: var(--v2-font-sans);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--v2-text);
		margin-bottom: 0.75rem;
	}

	.v2-title-highlight {
		color: var(--v2-green);
	}

	.v2-page-desc {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--v2-text-muted);
		max-width: 65ch;
	}

	/* Grep Filter Input */
	.v2-grep-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0.85rem;
		background: var(--v2-bg-elevated);
		border: 1px solid var(--v2-border-strong);
		margin-bottom: 1.25rem;
		box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.4);
	}

	.v2-grep-prompt {
		font-family: var(--v2-font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--v2-green);
		flex-shrink: 0;
	}

	.v2-grep-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: var(--v2-text);
		font-family: var(--v2-font-mono);
		font-size: 0.82rem;
	}

	.v2-grep-counter {
		font-family: var(--v2-font-mono);
		font-size: 0.72rem;
		color: var(--v2-text-dim);
		flex-shrink: 0;
	}

	/* Notes Window */
	.v2-notes-window {
		margin-bottom: 3.5rem;
	}

	.v2-notes-directory,
	.v2-notes-skeleton {
		display: flex;
		flex-direction: column;
	}

	.v2-notes-directory[hidden],
	.v2-notes-skeleton[hidden] {
		display: none !important;
	}

	.v2-note-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 0.85rem 1.15rem;
		border-bottom: 1px solid var(--v2-border);
		transition: background 0.12s ease;
		text-decoration: none;
	}

	.v2-note-row:last-child {
		border-bottom: none;
	}

	.v2-note-row:hover {
		background: var(--v2-bg-elevated);
	}

	.v2-note-row:hover .v2-note-title,
	.v2-note-row:hover .v2-note-arrow {
		color: var(--v2-green);
	}

	.v2-note-date {
		font-family: var(--v2-font-mono);
		font-size: 0.76rem;
		color: var(--v2-text-dim);
		flex-shrink: 0;
		width: 95px;
	}

	.v2-note-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		flex: 1;
		min-width: 0;
	}

	.v2-note-title {
		font-family: var(--v2-font-display);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--v2-text);
		transition: color 0.12s ease;
	}

	.v2-note-excerpt {
		font-size: 0.76rem;
		color: var(--v2-text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 65ch;
	}

	.v2-note-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.v2-note-read {
		font-family: var(--v2-font-mono);
		font-size: 0.72rem;
		color: var(--v2-text-dim);
	}

	.v2-note-arrow {
		font-size: 0.85rem;
		color: var(--v2-text-muted);
		transition: color 0.12s ease, transform 0.12s ease;
	}

	.v2-note-row:hover .v2-note-arrow {
		transform: translateX(2px);
	}

	.v2-empty-state {
		padding: 3rem 1.5rem;
		text-align: center;
		font-family: var(--v2-font-mono);
		font-size: 0.82rem;
		color: var(--v2-text-dim);
	}

	@media (max-width: 680px) {
		.v2-note-row {
			flex-direction: column;
			gap: 0.4rem;
			align-items: flex-start;
		}

		.v2-note-excerpt {
			white-space: normal;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
		}

		.v2-note-meta {
			width: 100%;
			justify-content: space-between;
			margin-top: 0.25rem;
		}
	}
</style>

<script>
	// Grep filter input
	const grepInput = document.getElementById("v2NotesGrepInput") as HTMLInputElement | null;
	const noteRows = Array.from(document.querySelectorAll<HTMLElement>("[data-note-item]"));
	const emptyNotice = document.getElementById("v2NotesEmpty");
	const counter = document.getElementById("v2NotesCounter");

	grepInput?.addEventListener("input", () => {
		const q = (grepInput.value || "").trim().toLowerCase();
		let matched = 0;

		noteRows.forEach((row) => {
			const t = row.dataset.title || "";
			const ex = row.dataset.excerpt || "";
			const matches = !q || t.includes(q) || ex.includes(q);
			row.style.display = matches ? "flex" : "none";
			if (matches) matched++;
		});

		if (emptyNotice) emptyNotice.hidden = matched > 0;
		if (counter) counter.textContent = `[${matched} entries]`;
	});
</script>
