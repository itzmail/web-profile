---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Modal from "../components/Modal.astro";
import ChatWidget from "../components/ChatWidget.astro";
interface ChatPageContext {
	type: "project" | "blog";
	title: string;
	description: string;
	extra?: string;
}
interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
	type?: "website" | "article";
	jsonLd?: Record<string, unknown>;
	chatPageContext?: ChatPageContext;
}
const {
	title = "Ismail Alam — Fullstack Architect",
	description = "Fullstack developer & architect. Building scalable systems, beautiful interfaces, and everything in between.",
	image = "/favicon.svg",
	canonicalURL = new URL(Astro.url.pathname, "https://itsmail.dev").toString(),
	type = "website",
	jsonLd,
	chatPageContext,
} = Astro.props;
const absoluteImage = new URL(image, "https://itsmail.dev").toString();
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<script is:inline>
			(function() {
				var t = localStorage.getItem("theme");
				if (t === "light" || t === "dark") {
					document.documentElement.setAttribute("data-theme", t);
				}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Ismail Alam" />
		<link rel="canonical" href={canonicalURL} />
		<!-- OG -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={absoluteImage} />
		<meta property="og:site_name" content="itsmail.dev" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImage} />
		{jsonLd && (
			<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		)}
		<!-- Preload fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	</head>
	<body>
		<Navbar />
		<slot />
		<Modal />
		<ChatWidget pageContext={chatPageContext} />
		<!-- Scroll Reveal Script -->
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("visible");
						}
					});
				},
				{ threshold: 0, rootMargin: "0px 0px -40px 0px" }
			);
			document
				.querySelectorAll(".reveal, .reveal-stagger")
				.forEach((el) => {
					observer.observe(el);
				});
		</script>
	</body>
</html>
